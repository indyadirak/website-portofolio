---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, locales, localeFromPathname, type Locale } from "../lib/i18n";
import { siteConfig } from "../lib/config";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ImageZoomModal from "../components/ImageZoomModal.astro";
import CvUnavailableModal from "../components/CvUnavailableModal.astro";

export interface Props {
  title: string;
  description?: string;
  /** Path og:image relatif public/ (default: /og-image.png — sediakan manual). */
  image?: string;
}

const { title, description, image = "/og-image.png" } = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = localeFromPathname(pathname) ?? "id";
const t = getDictionary(locale);

const pageTitle = title === siteConfig.name ? title : `${title} — ${siteConfig.name}`;

// Path relatif di dalam prefix bahasa: "/en/projects/" -> "projects"
const rest = pathname.replace(/^\/(id|en)\//, "").replace(/\/+$/, "");

// ===== SEO: canonical + hreflang (setiap locale + x-default) =====
const canonical = new URL(getRelativeLocaleUrl(locale, rest), siteConfig.url);
const hreflangLinks = locales
  .filter((l) => l !== locale)
  .map((l) => ({ locale: l, url: new URL(getRelativeLocaleUrl(l, rest), siteConfig.url) }));
const xDefaultUrl = new URL(getRelativeLocaleUrl("id", rest), siteConfig.url);

// ===== Open Graph locale-aware =====
const ogLocale = locale === "en" ? "en_US" : "id_ID";
const ogAlternateLocale = locale === "en" ? "id_ID" : "en_US";
const ogImageUrl = new URL(image, siteConfig.url);

// ===== JSON-LD Structured Data (Schema.org Person) — locale-aware =====
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteConfig.url}/#person`,
  name: siteConfig.author.name,
  jobTitle: t.hero.title,
  description: t.meta.home,
  url: siteConfig.url,
  inLanguage: locale,
  sameAs: [
    siteConfig.contact.linkedinUrl,
    siteConfig.contact.githubUrl,
  ].filter(Boolean),
  ...(siteConfig.author.alumniOf
    ? { alumniOf: { "@type": "CollegeOrUniversity", name: siteConfig.author.alumniOf } }
    : {}),
  knowsAbout: t.about.knowsAbout,
};

// JSON-LD di-inline via set:html — escape `<` menjadi \u003c (konsisten
// dengan CertificatesPage): JSON string tidak boleh memuat karakter yang
// bisa menutup tag <script>.
const personJsonLdJson = JSON.stringify(personJsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? t.meta.home} />
    <meta name="theme-color" content="#0b0c10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonical} />
    {hreflangLinks.map(({ locale: l, url }) => (
      <link rel="alternate" hreflang={l} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? t.meta.home} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={`${siteConfig.author.name} Portfolio`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description ?? t.meta.home} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{pageTitle}</title>

    <script
      is:inline
      type="application/ld+json"
      set:html={personJsonLdJson}
    ></script>
  </head>
  <body class="min-h-screen flex flex-col bg-cyber-bg">
    <!-- psst... buka Console browser (F12) — ada flag buat kamu. -->
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:border focus:border-cyber-primary focus:bg-cyber-panel focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-cyber-primary"
    >
      {t.ui.skipToContent}
    </a>
    <Navbar />
    <main id="konten" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ImageZoomModal />
    <CvUnavailableModal />

    <button
      id="to-top"
      type="button"
      aria-label={t.ui.backToTop}
      class="fixed bottom-6 right-6 z-40 hidden h-11 w-11 items-center justify-center rounded-lg border border-cyber-primary/40 bg-cyber-panel font-mono text-lg text-cyber-primary shadow-lg transition-colors hover:border-cyber-primary"
    >
      ↑
    </button>

    <script>
      // Scroll reveal: elemen .reveal tampil saat masuk viewport.
      const revealEls = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && revealEls.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("in"));
      }

      // Back to top: muncul setelah scroll 700px.
      const toTop = document.getElementById("to-top");
      if (toTop) {
        const onScroll = () => {
          const show = window.scrollY > 700;
          toTop.classList.toggle("hidden", !show);
          toTop.classList.toggle("flex", show);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        toTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
      }
    </script>
  </body>
</html>
