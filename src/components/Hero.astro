---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { siteConfig } from "../lib/config";
import CvDownloadButton from "./CvDownloadButton.astro";
import { getCertificates } from "../lib/data/certificates";
import { getProjects } from "../lib/data/projects";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const available = siteConfig.contact.availabilityStatus === "open-to-work";

// Statistik dinamis untuk "at a glance" (scan cepat recruiter).
const projectCount = (await getProjects()).length;
const certCount = (await getCertificates()).length;

// --type-steps: langkah animasi typing ≈ jumlah karakter + easing.
// (lebar animasi = 100% dari wrapper .w-fit, lihat .type-effect di global.css)
const typeSteps = t.hero.title.length + 8;
---

<section class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 cyber-grid opacity-[0.06]" />

  <div class="relative mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24 lg:py-32">
    <p class="font-mono text-xs text-cyber-accent md:text-sm">{t.hero.eyebrow}</p>

    <div class="mt-4 w-fit max-w-full">
      <h1
        class="type-effect font-mono text-3xl font-bold leading-tight text-cyber-primary glow-text lg:text-5xl"
        style={`--type-steps: ${typeSteps}; --type-duration: 2.4s;`}
      >
        {t.hero.title}
      </h1>
    </div>
    <span class="type-caret mt-4 hidden font-mono text-3xl text-cyber-accent md:inline-block lg:text-5xl" aria-hidden="true">
      █
    </span>

    <p class="mt-5 max-w-2xl font-mono text-sm text-cyber-muted md:text-lg">{t.hero.tagline}</p>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-cyber-muted md:text-base">
      {t.hero.description}
    </p>

    {
      available && (
        <p class="badge-pulse mt-8 inline-flex min-h-11 items-center rounded border border-cyber-primary/50 bg-cyber-primary/10 px-4 font-mono text-xs font-semibold text-cyber-primary md:text-sm">
          [ {t.hero.badge} ]
        </p>
      )
    }

    {
      /* At a glance: angka besar + label — scan 3 detik untuk recruiter. */
      <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-4 font-mono" aria-label={t.hero.statsLabel}>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-cyber-primary md:text-4xl">{projectCount}</span>
          <span class="text-xs uppercase tracking-wider text-cyber-muted md:text-sm">{t.hero.statsProjects}</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-cyber-primary md:text-4xl">{certCount}</span>
          <span class="text-xs uppercase tracking-wider text-cyber-muted md:text-sm">{t.hero.statsCertificates}</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class={`text-3xl font-bold md:text-4xl ${available ? "text-cyber-primary" : "text-cyber-danger"}`}>
            {available ? t.hero.statsOpen : t.hero.statsClosed}
          </span>
          <span class="text-xs uppercase tracking-wider text-cyber-muted md:text-sm">{t.hero.statsStatus}</span>
        </div>
      </div>
    }

    <div class="mt-10 flex flex-wrap items-center gap-3 font-mono text-sm">
      <a
        href={getRelativeLocaleUrl(locale, "projects")}
        class="inline-flex min-h-11 items-center rounded border border-cyber-primary/60 bg-cyber-primary/10 px-4 text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg md:px-5"
      >
        {t.hero.viewProjects}
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "contact")}
        class="inline-flex min-h-11 items-center rounded border border-cyber-border px-4 text-cyber-muted transition-colors hover:border-cyber-accent hover:text-cyber-accent md:px-5"
      >
        {t.hero.contactMe}
      </a>
      <CvDownloadButton variant="hero" />
      <a
        href={siteConfig.contact.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-1.5 rounded border border-cyber-border px-4 text-cyber-muted transition-colors hover:border-cyber-primary hover:text-cyber-primary md:px-5"
      >
        {t.footer.github}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6v6M10 14 20 4" />
        </svg>
      </a>
    </div>
  </div>
</section>
