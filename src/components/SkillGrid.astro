---
import type { Skill, SkillLevel } from "../lib/types";

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

const levelMeter: Record<SkillLevel, number> = {
  beginner: 25,
  intermediate: 50,
  advanced: 75,
  expert: 100,
};

const levelColor: Record<SkillLevel, string> = {
  beginner: "bg-cyber-accent",
  intermediate: "bg-cyber-accent",
  advanced: "bg-cyber-primary",
  expert: "bg-cyber-primary",
};
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {skills.map((skill) => (
    <div class="rounded border border-cyber-border bg-cyber-card p-5">
      <div class="flex items-center justify-between">
        <p class="flex items-center gap-2 font-mono text-sm font-semibold text-slate-200">
          {skill.icon && <span aria-hidden="true">{skill.icon}</span>}
          {skill.name}
        </p>
        <span class="font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
          {skill.category}
        </span>
      </div>
      <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-cyber-panel">
        <div
          class={`h-full rounded-full ${levelColor[skill.level]}`}
          data-meter-width={levelMeter[skill.level]}
        />
      </div>
    </div>
  ))}
</div>
