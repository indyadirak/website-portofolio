---
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { turnstile } from "../lib/config";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<form
  id="contact-form"
  class="space-y-5"
  data-i18n-success={t.contact.success}
  data-i18n-error={t.contact.errorPrefix}
  data-i18n-rate={t.contact.tooManyRequests}
  data-i18n-noconfig={t.contact.notConfigured}
  data-i18n-fail={t.contact.sendFailed}
  data-i18n-captcha={t.contact.captchaRequired}
>
  <div class="grid gap-5 md:grid-cols-2">
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
        {t.contact.formName}
      </span>
      <input
        type="text"
        name="name"
        required
        minlength={2}
        maxlength={100}
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 placeholder-cyber-muted/50 outline-none transition-colors focus:border-cyber-primary"
        placeholder={t.contact.namePlaceholder}
      />
    </label>
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
        {t.contact.formEmail}
      </span>
      <input
        type="email"
        name="email"
        required
        maxlength={254}
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 placeholder-cyber-muted/50 outline-none transition-colors focus:border-cyber-primary"
        placeholder={t.contact.emailPlaceholder}
      />
    </label>
  </div>

  <label class="block">
    <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
      {t.contact.formMessage}
    </span>
    <textarea
      name="message"
      required
      minlength={10}
      maxlength={5000}
      rows={6}
      class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 placeholder-cyber-muted/50 outline-none transition-colors focus:border-cyber-primary"
      placeholder={t.contact.messagePlaceholder}
    ></textarea>
  </label>

  <!--
    Honeypot: field palsu dengan nama umum "website", disembunyikan
    off-screen (bukan display:none) agar bot tidak curiga. Jika terisi,
    server menolak submission diam-diam (respons sukses palsu).
  -->
  <label class="hp-trap" aria-hidden="true">
    <span>Website</span>
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-6 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50"
    >
      {t.contact.sendMessage}
    </button>
    <p id="contact-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-muted"></p>
  </div>

  {
    turnstile.siteKey && (
      <div
        id="turnstile-widget"
        class="cf-turnstile"
        data-sitekey={turnstile.siteKey}
        data-language={locale === "en" ? "en" : "id"}
      ></div>
    )
  }
  <input type="hidden" id="turnstile-token" name="cf-turnstile-response" />
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status") as HTMLParagraphElement | null;

  const messages = {
    success: form?.dataset.i18nSuccess ?? "sent",
    errorPrefix: form?.dataset.i18nError ?? "$ error:",
    rate: form?.dataset.i18nRate ?? "rate limited",
    noconfig: form?.dataset.i18nNoconfig ?? "not configured",
    fail: form?.dataset.i18nFail ?? "failed",
    captcha: form?.dataset.i18nCaptcha ?? "complete the captcha first",
  };

  function show(text: string, ok: boolean): void {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle("text-cyber-primary", ok);
    status.classList.toggle("text-cyber-danger", !ok);
  }

  // ===== Turnstile (widget dirender eksplisit; callback global dipanggil
  // oleh api.js dari challenges.cloudflare.com) =====
  const widgetEl = document.getElementById("turnstile-widget");
  const tokenInput = document.getElementById("turnstile-token") as HTMLInputElement | null;

  type TurnstileApi = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => void;
  };

  (window as unknown as { onTurnstileSuccess?: (token: string) => void }).onTurnstileSuccess =
    (token: string) => {
      if (tokenInput) tokenInput.value = token;
    };

  let rendered = false;
  function renderTurnstile(): void {
    const api = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    if (!widgetEl || !api || rendered) return;
    rendered = true;
    api.render(widgetEl, {
      sitekey: widgetEl.dataset.sitekey,
      theme: "dark",
      language: widgetEl.dataset.language,
      callback: "onTurnstileSuccess",
    });
  }
  renderTurnstile();
  window.addEventListener("load", renderTurnstile);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    // Wajib selesaikan CAPTCHA sebelum submit (bila widget ada).
    if (widgetEl && (!tokenInput || !tokenInput.value)) {
      show(`${messages.errorPrefix} ${messages.captcha}`, false);
      return;
    }

    const data = new FormData(form);
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;

    let res: Response;
    try {
      res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: String(data.get("name") ?? ""),
          email: String(data.get("email") ?? ""),
          message: String(data.get("message") ?? ""),
          website: String(data.get("website") ?? ""),
          "cf-turnstile-response": tokenInput?.value ?? "",
        }),
      });
    } catch {
      button.disabled = false;
      show(`${messages.errorPrefix} ${messages.fail}`, false);
      return;
    }

    const result = await res.json().catch(() => ({ ok: false, error: "server" }));

    button.disabled = false;

    if (result.ok) {
      show(messages.success, true);
      form.reset();
      if (tokenInput) tokenInput.value = "";
      return;
    }

    switch (result.error) {
      case "too_many_requests":
        show(`${messages.errorPrefix} ${messages.rate}`, false);
        break;
      case "not_configured":
        show(`${messages.errorPrefix} ${messages.noconfig}`, false);
        break;
      case "captcha_failed":
        show(`${messages.errorPrefix} ${messages.captcha}`, false);
        break;
      default:
        show(`${messages.errorPrefix} ${messages.fail}`, false);
    }
  });
</script>
