---
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { turnstile } from "../lib/config";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<form
  id="contact-form"
  class="space-y-5"
  data-i18n-success={t.contact.success}
  data-i18n-error={t.contact.errorPrefix}
  data-i18n-rate={t.contact.tooManyRequests}
  data-i18n-noconfig={t.contact.notConfigured}
  data-i18n-fail={t.contact.sendFailed}
  data-i18n-captcha={t.contact.captchaRequired}
  data-i18n-captcha-unavailable={t.contact.captchaUnavailable}
>
  <div class="grid gap-5 md:grid-cols-2">
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
        {t.contact.formName}
      </span>
      <input
        type="text"
        name="name"
        required
        minlength={2}
        maxlength={100}
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 placeholder-cyber-muted/50 outline-none transition-colors focus:border-cyber-primary"
        placeholder={t.contact.namePlaceholder}
      />
    </label>
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
        {t.contact.formEmail}
      </span>
      <input
        type="email"
        name="email"
        required
        maxlength={254}
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 placeholder-cyber-muted/50 outline-none transition-colors focus:border-cyber-primary"
        placeholder={t.contact.emailPlaceholder}
      />
    </label>
  </div>

  <label class="block">
    <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
      {t.contact.formMessage}
    </span>
    <textarea
      name="message"
      required
      minlength={10}
      maxlength={5000}
      rows={6}
      class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 placeholder-cyber-muted/50 outline-none transition-colors focus:border-cyber-primary"
      placeholder={t.contact.messagePlaceholder}
    ></textarea>
  </label>

  <label class="hp-trap" aria-hidden="true">
    <span>Website</span>
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-6 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50"
    >
      {t.contact.sendMessage}
    </button>
    <p id="contact-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-muted"></p>
  </div>

  {
    turnstile.siteKey && (
      <div
        id="turnstile-widget"
        class="cf-turnstile"
        data-sitekey={turnstile.siteKey}
        data-language={locale === "en" ? "en" : "id"}
      ></div>
    )
  }
  <input type="hidden" id="turnstile-token" name="cf-turnstile-response" />
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status") as HTMLParagraphElement | null;

  const messages = {
    success: form?.dataset.i18nSuccess ?? "sent",
    errorPrefix: form?.dataset.i18nError ?? "$ error:",
    rate: form?.dataset.i18nRate ?? "rate limited",
    noconfig: form?.dataset.i18nNoconfig ?? "not configured",
    fail: form?.dataset.i18nFail ?? "failed",
    captcha: form?.dataset.i18nCaptcha ?? "complete the captcha first",
    captchaUnavailable: form?.dataset.i18nCaptchaUnavailable ?? "captcha widget failed to load",
  };

  function show(text: string, ok: boolean): void {
    if (!status) return;
    status.textContent = text;
    status.classList.toggle("text-cyber-primary", ok);
    status.classList.toggle("text-cyber-danger", !ok);
  }

  // ===== Turnstile (widget dirender eksplisit; callback global dipanggil
  // oleh api.js dari challenges.cloudflare.com) =====
  // Anti-race: api.js dimuat async — window.turnstile bisa belum siap saat
  // script modul ini jalan. Kita poll sampai siap (bukan andalkan event
  // `load` saja), lalu render SEKALI. widgetId disimpan agar widget bisa
  // di-reset setelah submit (wajib: `form.reset()` hanya membersihkan
  // hidden input, bukan state visual widget — tanpa reset, user yang sudah
  // "solve" lalu submit lagi akan memakai token lama/basi).
  const widgetEl = document.getElementById("turnstile-widget");
  const tokenInput = document.getElementById("turnstile-token") as HTMLInputElement | null;

  type TurnstileApi = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset(id: string): void;
  };

  let widgetId: string | null = null;
  let renderStarted = false;
  let apiFailed = false;

  function clearToken(): void {
    if (tokenInput) tokenInput.value = "";
  }

  /** Reset visual+internal state widget setelah submit (sukses maupun gagal),
   *  agar user bisa mencoba lagi tanpa refresh — token lama dibersihkan. */
  function resetWidget(): void {
    if (widgetId) {
      (window as unknown as { turnstile?: TurnstileApi }).turnstile?.reset(widgetId);
    }
    clearToken();
  }

  (window as unknown as { onTurnstileSuccess?: (token: string) => void }).onTurnstileSuccess =
    (token: string) => {
      if (tokenInput) tokenInput.value = token;
    };

  function renderTurnstile(): void {
    if (renderStarted || !widgetEl) return;
    const api = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    if (!api) return;
    renderStarted = true;
    try {
      widgetId = api.render(widgetEl, {
        sitekey: widgetEl.dataset.sitekey,
        theme: "dark",
        language: widgetEl.dataset.language,
        callback: "onTurnstileSuccess",
        "expired-callback": clearToken,
        "error-callback": clearToken,
      });
    } catch (err) {
      console.error("[contact] Gagal render Turnstile:", err);
      apiFailed = true;
    }
  }

  // Tunggu API Turnstile siap (poll 200ms, maks 10 detik). Dev tanpa
  // siteKey: widgetEl tidak ada — fungsi langsung no-op.
  function waitForTurnstile(maxMs = 10_000): Promise<boolean> {
    return new Promise((resolve) => {
      if (!widgetEl) return resolve(true);
      const started = Date.now();
      const timer = window.setInterval(() => {
        if ((window as unknown as { turnstile?: unknown }).turnstile) {
          renderTurnstile();
          window.clearInterval(timer);
          resolve(!apiFailed);
        } else if (Date.now() - started > maxMs) {
          window.clearInterval(timer);
          apiFailed = true;
          resolve(false);
        }
      }, 200);
    });
  }

  // Mulai render sesegera mungkin (jangan menunggu `load`).
  void waitForTurnstile();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    // Anti-race render vs submit: beri widget kesempatan render dulu
    // (max 3 detik setelah klik), baru evaluasi token.
    if (widgetEl && tokenInput) {
      if ((window as unknown as { turnstile?: unknown }).turnstile) renderTurnstile();
      else if (!(await waitForTurnstile(3_000))) {
        show(`${messages.errorPrefix} ${messages.captchaUnavailable}`, false);
        return;
      }
    }

    // Wajib selesaikan CAPTCHA sebelum submit (bila widget ada & sehat).
    if (widgetEl && (!tokenInput || !tokenInput.value)) {
      if (apiFailed) {
        show(`${messages.errorPrefix} ${messages.captchaUnavailable}`, false);
        return;
      }
      show(`${messages.errorPrefix} ${messages.captcha}`, false);
      return;
    }

    const data = new FormData(form);
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;

    // ===== DEBUG TURNSTILE — membedakan kegagalan frontend vs edge vs backend =====
    console.log("[FRONTEND DEBUG] Attempting to submit form. Token exists:", !!tokenInput?.value);

    let res: Response;
    try {
      res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: String(data.get("name") ?? ""),
          email: String(data.get("email") ?? ""),
          message: String(data.get("message") ?? ""),
          website: String(data.get("website") ?? ""),
          "cf-turnstile-response": tokenInput?.value ?? "",
        }),
      });
    } catch {
      button.disabled = false;
      show(`${messages.errorPrefix} ${messages.fail}`, false);
      return;
    }

    const result = await res.json().catch(() => ({ ok: false, error: "server" }));

    button.disabled = false;

    if (result.ok) {
      show(messages.success, true);
      form.reset();
      // Reset widget: state visual & token internal Turnstile ikut dibersihkan
      // (form.reset() hanya membersihkan input hidden, bukan widget).
      resetWidget();
      return;
    }

    switch (result.error) {
      case "too_many_requests":
        show(`${messages.errorPrefix} ${messages.rate}`, false);
        break;
      case "not_configured":
        show(`${messages.errorPrefix} ${messages.noconfig}`, false);
        break;
      case "captcha_failed":
        // Token ditolak backend — reset widget agar user bisa coba ulang
        // tanpa refresh halaman.
        resetWidget();
        show(`${messages.errorPrefix} ${messages.captcha}`, false);
        break;
      default:
        resetWidget();
        show(`${messages.errorPrefix} ${messages.fail}`, false);
    }
  });
</script>
