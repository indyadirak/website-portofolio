---
import { getDictionary, localeFromPathname } from "../../lib/i18n";
import type { Dictionary } from "../../lib/i18n/types";

interface Props {
  /** Perintah terminal yang ditampilkan (default: "ls"). */
  command?: string;
  /** Direktori/argumen perintah (default: "/"). */
  directory?: string;
  /** Kunci i18n bertitik, misal "projects.noProjects" — pesan yang ditampilkan. */
  messageId?: string;
  id?: string;
  hidden?: boolean;
  class?: string;
}

const { messageId = "", id, hidden = false, class: className } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

/** Resolusi kunci i18n bertitik ("projects.noProjects") ke nilai string. */
function resolveMessage(key: string): string {
  const value = key.split(".").reduce<unknown>(
    (acc, part) =>
      acc !== null && typeof acc === "object"
        ? (acc as Record<string, unknown>)[part]
        : undefined,
    t as unknown as Dictionary,
  );
  return typeof value === "string" ? value : "";
}

const message = resolveMessage(messageId);
---

<div
  id={id}
  hidden={hidden || undefined}
  class={`rounded border border-cyber-border bg-cyber-card p-6 font-mono text-sm text-cyber-muted ${className ?? ""}`}
>
  {message && <p>{message}</p>}
</div>
