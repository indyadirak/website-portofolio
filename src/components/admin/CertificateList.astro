---
import type { CertificatesRow } from "../../lib/types";
import { getDictionary, localeFromPathname } from "../../lib/i18n";

interface Props {
  certificates: CertificatesRow[];
  /** Admin/editor: boleh edit. */
  canWrite: boolean;
  /** Admin saja: boleh delete. */
  isAdmin: boolean;
}

const { certificates, canWrite, isAdmin } = Astro.props;
const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<div
  class="space-y-3"
  data-i18n-confirm-delete={t.adminCertificates.confirmDelete}
  data-i18n-delete-failed={t.adminCertificates.deleteFailed}
>
  {
    certificates.length > 0 ? (
      certificates.map((cert) => (
        <article
          class="flex flex-col gap-3 rounded border border-cyber-border bg-cyber-card p-5 md:flex-row md:items-center md:justify-between"
          data-cert-json={JSON.stringify(cert)}
        >
          <div>
            <h3 class="font-mono text-base font-bold text-white">
              {cert.title}
              {cert.is_featured && (
                <span class="ml-2 rounded border border-cyber-primary/50 px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-cyber-primary">
                  {t.adminCertificates.featuredBadge}
                </span>
              )}
            </h3>
            <p class="mt-1 font-mono text-xs text-cyber-muted">
              {cert.issuer} — {cert.issue_date}
              <span class="ml-2 rounded border border-cyber-border px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-cyber-accent">
                {cert.category}
              </span>
              {cert.expiry_date && (
                <span class="ml-2 text-[10px] uppercase tracking-wider text-cyber-muted">
                  [ {cert.expiry_date} ]
                </span>
              )}
              {cert.credential_url && (
                <a href={cert.credential_url} target="_blank" rel="noopener noreferrer" class="ml-2 text-cyber-accent hover:underline">
                  [ credential ]
                </a>
              )}
              {cert.file_url && (
                <span class="ml-2 text-cyber-muted">
                  {cert.file_url.startsWith("https://")
                    ? "[ file: google_drive ]"
                    : `[ file: ${cert.file_url.split("/").pop()} ]`}
                </span>
              )}
            </p>
            {
              cert.skills.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-2">
                  {cert.skills.map((skill) => (
                    <span class="font-mono text-[11px] text-cyber-primary/80">#{skill}</span>
                  ))}
                </div>
              )
            }
          </div>

          <div class="flex shrink-0 items-center gap-3 font-mono text-xs">
            {
              canWrite && (
                <button
                  type="button"
                  data-action="edit"
                  class="rounded border border-cyber-border px-4 py-2 text-cyber-accent transition-colors hover:border-cyber-accent"
                >
                  {t.adminCertificates.editAction}
                </button>
              )
            }
            {
              isAdmin && (
                <button
                  type="button"
                  data-action="delete"
                  class="rounded border border-cyber-danger/50 px-4 py-2 text-cyber-danger transition-colors hover:bg-cyber-danger/10"
                >
                  {t.adminCertificates.deleteAction}
                </button>
              )
            }
          </div>
        </article>
      ))
    ) : (
      <p class="rounded border border-cyber-border bg-cyber-card p-8 font-mono text-sm text-cyber-muted">
        {t.adminCertificates.emptyList}
      </p>
    )
  }
</div>

<script>
  const listRoot = document.querySelector("[data-i18n-confirm-delete]") as HTMLElement | null;
  const confirmDeleteTpl =
    listRoot?.dataset.i18nConfirmDelete ?? 'Hapus "{title}"? Aksi ini tidak dapat dibatalkan.';
  const deleteFailedTpl =
    listRoot?.dataset.i18nDeleteFailed ?? "Gagal menghapus: {error}";

  document.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
    const card = btn.closest<HTMLElement>("[data-cert-json]");
    if (!card) return;

    const cert = JSON.parse(card.dataset.certJson ?? "null") as {
      id: string;
      title: string;
      issuer: string;
      issue_date: string;
      expiry_date?: string | null;
      category?: "compliance" | "training";
      is_featured?: boolean;
      short_description_id?: string | null;
      short_description_en?: string | null;
      credential_id?: string | null;
      credential_url?: string | null;
      verification_url?: string | null;
      file_url?: string | null;
      skills: string[];
    };

    if (btn.dataset.action === "edit") {
      btn.addEventListener("click", () => {
        window.dispatchEvent(
          new CustomEvent("certificate:edit", {
            detail: {
              id: cert.id,
              title: cert.title,
              issuer: cert.issuer,
              issueDate: cert.issue_date,
              expiryDate: cert.expiry_date,
              category: cert.category ?? "training",
              isFeatured: Boolean(cert.is_featured),
              shortDescriptionId: cert.short_description_id,
              shortDescriptionEn: cert.short_description_en,
              credentialId: cert.credential_id,
              credentialUrl: cert.credential_url,
              verificationUrl: cert.verification_url,
              fileUrl: cert.file_url,
              skills: cert.skills,
            },
          })
        );
      });
    }

    if (btn.dataset.action === "delete") {
      btn.addEventListener("click", async () => {
        if (!window.confirm(confirmDeleteTpl.replace("{title}", cert.title))) return;

        btn.disabled = true;
        const res = await fetch(`/api/certificates?id=${encodeURIComponent(cert.id)}`, {
          method: "DELETE",
        });
        const data = await res.json();

        if (!res.ok || !data.ok) {
          window.alert(deleteFailedTpl.replace("{error}", String(data.error ?? "unknown")));
          btn.disabled = false;
          return;
        }

        window.location.reload();
      });
    }
  });
</script>
