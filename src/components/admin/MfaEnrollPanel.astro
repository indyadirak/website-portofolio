---
/**
 * Panel MFA Enrollment — untuk admin/editor yang baru pertama kali login.
 * Alur: enroll (QR TOTP) -> user scan -> masukkan kode 6 digit -> verify
 * -> sesi aal2 -> redirect ke dashboard.
 */
import { getDictionary, localeFromPathname } from "../../lib/i18n";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<div
  id="enroll-panel"
  class="space-y-4"
  data-i18n-title={t.adminMfa.title}
  data-i18n-description={t.adminMfa.description}
  data-i18n-retry-action={t.adminMfa.retryAction}
  data-i18n-verify-action={t.adminMfa.verifyAction}
  data-i18n-loading-text={t.adminMfa.loadingText}
  data-i18n-secret-label={t.adminMfa.secretLabel}
  data-i18n-code-label={t.adminMfa.codeLabel}
  data-i18n-qr-alt={t.adminMfa.qrAlt}
  data-i18n-error-prefix={t.adminMfa.errorPrefix}
  data-i18n-err-unauthorized={t.adminMfa.errUnauthorized}
  data-i18n-err-enroll-failed={t.adminMfa.errEnrollFailed}
  data-i18n-err-timeout={t.adminMfa.errTimeout}
  data-i18n-err-invalid-response={t.adminMfa.errInvalidResponse}
  data-i18n-err-session-failed={t.adminMfa.errSessionFailed}
  data-i18n-err-network={t.adminMfa.errNetwork}
  data-i18n-err-too-many={t.adminMfa.errTooMany}
  data-i18n-err-generic={t.adminMfa.errGeneric}
  data-i18n-err-code-must-be-6={t.adminMfa.errCodeMustBe6}
  data-i18n-err-invalid-code={t.adminMfa.errInvalidCode}
>
  <div
    id="enroll-loading"
    class="rounded border border-cyber-border/70 bg-cyber-card/60 p-4 font-mono text-sm text-cyber-muted"
  >
    <span id="enroll-loading-text">{t.adminMfa.loadingText}</span>
    <button
      id="enroll-retry"
      type="button"
      hidden
      class="mt-4 block rounded border border-cyber-danger/60 bg-cyber-danger/10 px-4 py-2 text-xs text-cyber-danger transition-colors hover:bg-cyber-danger hover:text-cyber-bg"
    >
      {t.adminMfa.retryAction}
    </button>
  </div>

  <div id="enroll-content" hidden class="space-y-4">
    <div>
      <div class="flex items-start gap-3">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyber-primary/15 font-mono text-sm text-cyber-primary">2</span>
        <div>
          <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-white">{t.adminMfa.title}</h2>
          <p class="mt-1 text-sm leading-relaxed text-cyber-muted">
            {t.adminMfa.description}
          </p>
        </div>
      </div>

      <div class="mt-5 flex flex-col items-center gap-5 md:flex-row md:items-start">
        <img
          id="enroll-qr"
          class="h-56 w-56 rounded border border-cyber-border bg-white p-2"
          alt={t.adminMfa.qrAlt}
          width="224"
          height="224"
        />
        <div class="flex-1 space-y-3">
          <div class="w-full">
            <p class="mb-1 font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
              {t.adminMfa.secretLabel}
            </p>
            <code id="enroll-secret" class="block break-all rounded bg-cyber-panel px-3 py-2 font-mono text-xs text-cyber-primary"></code>
          </div>
          <label class="block">
            <span class="mb-1 block font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
              {t.adminMfa.codeLabel}
            </span>
            <input
              id="enroll-code"
              type="text"
              inputmode="numeric"
              pattern="\d{6}"
              maxlength="6"
              required
              autocomplete="one-time-code"
              class="w-full max-w-[180px] rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 text-center font-mono text-lg tracking-[0.5em] text-slate-200 outline-none focus:border-cyber-primary"
              placeholder="000000"
            />
          </label>
          <button
            id="enroll-verify"
            type="button"
            class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-5 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50"
          >
            {t.adminMfa.verifyAction}
          </button>
          <p id="enroll-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-danger"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let factorId: string | null = null;
  let enrollStarted = false;

  // Elemen dijamin ada (didefinisikan di komponen ini).
  // Teks status isolated di <span> sendiri: menulis textContent ke container
  // akan menghapus tombol retry dari DOM (bug: retry tidak pernah muncul).
  const loading = document.getElementById("enroll-loading") as HTMLDivElement;
  const loadingTextEl = document.getElementById("enroll-loading-text") as HTMLSpanElement;
  const retryBtn = document.getElementById("enroll-retry") as HTMLButtonElement;
  const content = document.getElementById("enroll-content") as HTMLDivElement;
  const qrImg = document.getElementById("enroll-qr") as HTMLImageElement;
  const secretEl = document.getElementById("enroll-secret") as HTMLElement;
  const codeInput = document.getElementById("enroll-code") as HTMLInputElement;
  const verifyBtn = document.getElementById("enroll-verify") as HTMLButtonElement;
  const statusEl = document.getElementById("enroll-status") as HTMLParagraphElement;
  const panel = document.getElementById("enroll-panel") as HTMLDivElement;
  const ds = panel.dataset;

  const errPrefix = ds.i18nErrorPrefix ?? "$ error:";
  const FAIL_MESSAGES: Record<string, string> = {
    unauthorized: ds.i18nErrUnauthorized ?? "",
    enroll_gagal: ds.i18nErrEnrollFailed ?? "",
    timeout: ds.i18nErrTimeout ?? "",
    invalid_response: ds.i18nErrInvalidResponse ?? "",
    session_gagal: ds.i18nErrSessionFailed ?? "",
    network_error: ds.i18nErrNetwork ?? "",
    too_many_attempts: ds.i18nErrTooMany ?? "",
  };
  const errGeneric = ds.i18nErrGeneric ?? "";
  const errCodeMustBe6 = ds.i18nErrCodeMustBe6 ?? "";
  const errInvalidCode = ds.i18nErrInvalidCode ?? "";
  const loadingText = ds.i18nLoadingText ?? "";

  // Batas tunggu API enrollment — tanpa ini fetch bisa hang selamanya
  // dan spinner "generating_qr_code..." tidak pernah berhenti.
  const ENROLL_TIMEOUT_MS = 15_000;

  async function enroll(): Promise<void> {
    loading.hidden = false;
    content.hidden = true;
    retryBtn.hidden = true;
    loadingTextEl.textContent = loadingText;

    const controller = new AbortController();
    const timeoutId = window.setTimeout(() => controller.abort(), ENROLL_TIMEOUT_MS);

    let res: Response;
    try {
      res = await fetch("/api/auth/mfa-enroll", {
        method: "POST",
        signal: controller.signal,
      });
    } catch (err) {
      window.clearTimeout(timeoutId);
      const aborted = err instanceof DOMException && err.name === "AbortError";
      loadingTextEl.textContent = `${errPrefix} ${FAIL_MESSAGES[aborted ? "timeout" : "unauthorized"] ?? errGeneric}`;
      loading.hidden = false;
      retryBtn.hidden = false;
      return;
    }
    window.clearTimeout(timeoutId);

    let data: { ok?: boolean; factorId?: string; qrDataUrl?: string; secret?: string; error?: string };
    try {
      data = await res.json();
    } catch {
      data = { ok: false, error: "invalid_response" };
    }

    if (!res.ok || !data.ok) {
      const code = data.error ?? "unknown";
      loadingTextEl.textContent = `${errPrefix} ${FAIL_MESSAGES[code] ?? errGeneric}`;
      retryBtn.hidden = false;
      return;
    }

    if (!data.factorId || !data.qrDataUrl || !data.secret) {
      loadingTextEl.textContent = `${errPrefix} ${FAIL_MESSAGES.invalid_response}`;
      retryBtn.hidden = false;
      return;
    }

    factorId = data.factorId;
    qrImg.src = data.qrDataUrl;
    secretEl.textContent = data.secret;
    loading.hidden = true;
    content.hidden = false;
  }

  retryBtn.addEventListener("click", () => {
    enrollStarted = false;
    void enroll();
  });

  verifyBtn.addEventListener("click", async () => {
    const code = codeInput.value.trim();
    if (!/^\d{6}$/.test(code)) {
      statusEl.textContent = errCodeMustBe6;
      return;
    }

    verifyBtn.disabled = true;
    statusEl.textContent = "";

    let res: Response;
    let data: { ok?: boolean; error?: string };
    try {
      res = await fetch("/api/auth/mfa-enroll-verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ factorId, code }),
      });
      data = await res.json();
    } catch {
      statusEl.textContent = `${errPrefix} ${FAIL_MESSAGES.network_error}`;
      verifyBtn.disabled = false;
      return;
    }

    if (!res.ok || !data.ok) {
      statusEl.textContent = `${errPrefix} ${FAIL_MESSAGES[data.error ?? ""] ?? data.error ?? errInvalidCode}`;
      verifyBtn.disabled = false;
      return;
    }

    window.location.href = "/admin/dashboard";
  });

  // PENTING: enrollment TIDAK boleh dijalankan saat page load. Panel ini
  // selalu ada di DOM halaman login (tersembunyi), dan saat load belum ada
  // sesi -> /api/auth/mfa-enroll pasti 401 "unauthorized", lalu error basi
  // itu tertinggal tampil di panel saat step "enroll" muncul setelah login.
  // Sebagai gantinya, login.astro mengirim event saat step enroll tampil.
  document.addEventListener("admin:enroll-request", () => {
    if (enrollStarted) return;
    enrollStarted = true;
    void enroll();
  });
</script>
