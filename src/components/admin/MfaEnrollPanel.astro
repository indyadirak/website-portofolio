---
/**
 * Panel MFA Enrollment — untuk admin/editor yang baru pertama kali login.
 * Alur: enroll (QR TOTP) -> user scan -> masukkan kode 6 digit -> verify
 * -> sesi aal2 -> redirect ke dashboard.
 */
---

<div id="enroll-panel" class="space-y-5">
  <div
    id="enroll-loading"
    class="rounded border border-cyber-border bg-cyber-card p-6 font-mono text-sm text-cyber-muted"
  >
    $ generating_qr_code...
  </div>

  <div id="enroll-content" hidden class="space-y-5">
    <div class="rounded border border-cyber-border bg-cyber-card p-6">
      <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
        [ mfa_enrollment_required ]
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-cyber-muted">
        Role Anda (admin/editor) mewajibkan Multi-Factor Authentication.
        Scan QR berikut dengan aplikasi authenticator (Google Authenticator, Authy, dll),
        lalu masukkan kode 6 digit untuk menyelesaikan pendaftaran.
      </p>

      <div class="mt-6 flex flex-col items-center gap-6 md:flex-row md:items-start">
        <img
          id="enroll-qr"
          class="h-56 w-56 rounded border border-cyber-border bg-white p-2"
          alt="TOTP QR code"
          width="224"
          height="224"
        />
        <div class="flex-1 space-y-3">
          <div>
            <p class="mb-1 font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
              Kode manual (bila tidak bisa scan)
            </p>
            <code id="enroll-secret" class="block break-all rounded bg-cyber-panel px-3 py-2 font-mono text-xs text-cyber-primary"></code>
          </div>
          <label class="block">
            <span class="mb-1 block font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
              Kode 6 digit
            </span>
            <input
              id="enroll-code"
              type="text"
              inputmode="numeric"
              pattern="\d{6}"
              maxlength="6"
              required
              autocomplete="one-time-code"
              class="w-full max-w-[180px] rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 text-center font-mono text-lg tracking-[0.5em] text-slate-200 outline-none focus:border-cyber-primary"
              placeholder="000000"
            />
          </label>
          <button
            id="enroll-verify"
            type="button"
            class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-5 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50"
          >
            [ verify_mfa ]
          </button>
          <p id="enroll-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-danger"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let factorId: string | null = null;
  let enrollStarted = false;

  // Elemen dijamin ada (didefinisikan di komponen ini).
  const loading = document.getElementById("enroll-loading") as HTMLDivElement;
  const content = document.getElementById("enroll-content") as HTMLDivElement;
  const qrImg = document.getElementById("enroll-qr") as HTMLImageElement;
  const secretEl = document.getElementById("enroll-secret") as HTMLElement;
  const codeInput = document.getElementById("enroll-code") as HTMLInputElement;
  const verifyBtn = document.getElementById("enroll-verify") as HTMLButtonElement;
  const statusEl = document.getElementById("enroll-status") as HTMLParagraphElement;

  async function enroll(): Promise<void> {
    loading.textContent = "$ generating_qr_code...";
    const res = await fetch("/api/auth/mfa-enroll", { method: "POST" });
    const data = await res.json();

    if (!res.ok || !data.ok) {
      loading.textContent = `$ error: ${data.error ?? "enroll gagal"}`;
      return;
    }

    factorId = data.factorId;
    qrImg.src = data.qrDataUrl;
    secretEl.textContent = data.secret;
    loading.hidden = true;
    content.hidden = false;
  }

  verifyBtn.addEventListener("click", async () => {
    const code = codeInput.value.trim();
    if (!/^\d{6}$/.test(code)) {
      statusEl.textContent = "$ kode harus 6 digit";
      return;
    }

    verifyBtn.disabled = true;
    statusEl.textContent = "";

    const res = await fetch("/api/auth/mfa-enroll-verify", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ factorId, code }),
    });
    const data = await res.json();

    if (!res.ok || !data.ok) {
      statusEl.textContent = `$ error: ${data.error ?? "kode tidak valid"}`;
      verifyBtn.disabled = false;
      return;
    }

    window.location.href = "/admin/dashboard";
  });

  // PENTING: enrollment TIDAK boleh dijalankan saat page load. Panel ini
  // selalu ada di DOM halaman login (tersembunyi), dan saat load belum ada
  // sesi -> /api/auth/mfa-enroll pasti 401 "unauthorized", lalu error basi
  // itu tertinggal tampil di panel saat step "enroll" muncul setelah login.
  // Sebagai gantinya, login.astro mengirim event saat step enroll tampil.
  document.addEventListener("admin:enroll-request", () => {
    if (enrollStarted) return;
    enrollStarted = true;
    enroll();
  });
</script>
