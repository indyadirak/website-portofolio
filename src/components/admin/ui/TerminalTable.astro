---
interface Props {
  /** Definisi kolom header — body diisi lewat slot. */
  columns: Array<{ key: string; label: string }>;
  class?: string;
}

const { columns, class: className } = Astro.props;
---

<div class={`overflow-x-auto rounded border border-cyber-border bg-cyber-card ${className ?? ""}`}>
  <table class="w-full text-left font-mono text-sm">
    <thead class="border-b border-cyber-border/60 text-[11px] uppercase tracking-wider text-cyber-muted">
      <tr>
        {columns.map((col) => (
          <th class="px-4 py-3">
            {col.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <slot />
    </tbody>
  </table>
</div>