---
/**
 * Form tambah/edit sertifikat.
 * Hanya dirender oleh dashboard untuk role admin & editor.
 */
---

<form id="cert-form" class="space-y-5">
  <p id="cert-form-mode" class="font-mono text-xs uppercase tracking-wider text-cyber-accent">
    [ add_certificate ]
  </p>

  <div class="grid gap-5 md:grid-cols-2">
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Category *</span>
      <select id="f-category" required
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">
        <option value="training">Training (kursus / workshop)</option>
        <option value="compliance">Compliance (kepatuhan standar)</option>
      </select>
    </label>
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Title *</span>
      <input id="f-title" type="text" required minlength={3}
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary"
        placeholder="OSCP — Offensive Security" />
    </label>
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Issuer *</span>
      <input id="f-issuer" type="text" required minlength={2}
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary"
        placeholder="Offensive Security" />
    </label>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Issue Date *</span>
      <input id="f-issue-date" type="date" required
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary" />
    </label>
    <label class="block">
      <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Expiry Date</span>
      <input id="f-expiry-date" type="date"
        class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary" />
    </label>
  </div>

  <label class="block">
    <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Credential URL</span>
    <input id="f-credential-url" type="url"
      class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary"
      placeholder="https://www.credly.com/badges/..." />
  </label>

  <label class="block">
    <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Skills (koma)</span>
    <input id="f-skills" type="text"
      class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary"
      placeholder="Penetration Testing, Active Directory, Linux" />
  </label>

  <label class="block">
    <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">
      File Sertifikat (PDF / PNG / JPG / WEBP / GIF, maks 5 MB) — PNG/JPG otomatis dikompres ke WebP
    </span>
    <input id="f-file" type="file"
      accept=".pdf,.png,.jpg,.jpeg,.webp,.gif,application/pdf,image/png,image/jpeg,image/webp,image/gif"
      class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary file:mr-3 file:rounded file:border-0 file:bg-cyber-card file:px-3 file:py-1.5 file:font-mono file:text-xs file:text-cyber-primary" />
    <p id="f-file-size" class="mt-2 hidden font-mono text-[11px] text-cyber-primary" aria-live="polite"></p>
    <p id="f-file-current" class="mt-2 font-mono text-[11px] text-cyber-muted"></p>
  </label>

  <div class="flex items-center gap-4">
    <button type="submit" id="f-submit"
      class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-6 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50">
      [ save_certificate ]
    </button>
    <button type="button" id="f-cancel" hidden
      class="rounded border border-cyber-border px-5 py-2.5 font-mono text-sm text-slate-300 hover:border-cyber-accent hover:text-cyber-accent">
      [ cancel_edit ]
    </button>
    <p id="f-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-danger"></p>
  </div>
</form>

<script>
  const form = document.getElementById("cert-form") as HTMLFormElement;
  const modeEl = document.getElementById("cert-form-mode") as HTMLParagraphElement;
  const submitBtn = document.getElementById("f-submit") as HTMLButtonElement;
  const cancelBtn = document.getElementById("f-cancel") as HTMLButtonElement;
  const statusEl = document.getElementById("f-status") as HTMLParagraphElement;

  const title = document.getElementById("f-title") as HTMLInputElement;
  const issuer = document.getElementById("f-issuer") as HTMLInputElement;
  const issueDate = document.getElementById("f-issue-date") as HTMLInputElement;
  const expiryDate = document.getElementById("f-expiry-date") as HTMLInputElement;
  const credentialUrl = document.getElementById("f-credential-url") as HTMLInputElement;
  const skills = document.getElementById("f-skills") as HTMLInputElement;
  const category = document.getElementById("f-category") as HTMLSelectElement;
  const fileInput = document.getElementById("f-file") as HTMLInputElement;
  const fileCurrent = document.getElementById("f-file-current") as HTMLParagraphElement;
  const sizeEl = document.getElementById("f-file-size") as HTMLParagraphElement;

  let editingId: string | null = null;

  interface CertEditDetail {
    id: string;
    title: string;
    issuer: string;
    issueDate: string;
    expiryDate?: string | null;
    category?: "compliance" | "training";
    credentialUrl?: string | null;
    skills?: string[];
    fileUrl?: string | null;
  }

  function toInput(value: string | null | undefined): string {
    return value ?? "";
  }

  function setMode(editing: boolean): void {
    editingId = editing ? editingId : null;
    modeEl.textContent = editing ? "[ edit_certificate ]" : "[ add_certificate ]";
    submitBtn.textContent = editing ? "[ update_certificate ]" : "[ save_certificate ]";
    cancelBtn.hidden = !editing;
    if (!editing) {
      fileInput.value = "";
      fileCurrent.textContent = "";
      sizeEl.classList.add("hidden");
    }
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  /**
   * Kompres gambar via Canvas API (tanpa library eksternal):
   * - Resolusi maksimal lebar 1600px (rasio dipertahankan)
   * - Format WebP, kualitas ~0.8
   * - Nama file unik (timestamp + UUID)
   * Catatan: re-encode canvas hanya menyalin piksel, sehingga metadata EXIF
   * (termasuk data GPS/lokasi) dari foto asli OTOMATIS dibuang — nilai
   * tambah privasi di luar sekadar pengurangan ukuran file.
   */
  async function compressToWebp(file: File): Promise<File | null> {
    let bitmap: ImageBitmap;
    try {
      bitmap = await createImageBitmap(file);
    } catch {
      // Fallback decode via <img> (Safari), lalu dibuat bitmap dari elemen.
      const url = URL.createObjectURL(file);
      try {
        const img = new Image();
        await new Promise<void>((resolve, reject) => {
          img.onload = () => resolve();
          img.onerror = () => reject(new Error("decode_failed"));
          img.src = url;
        });
        bitmap = await createImageBitmap(img);
        URL.revokeObjectURL(url);
      } catch (err) {
        URL.revokeObjectURL(url);
        throw err;
      }
    }

    const maxWidth = 1600;
    const scale = Math.min(1, maxWidth / bitmap.width);
    const width = Math.max(1, Math.round(bitmap.width * scale));
    const height = Math.max(1, Math.round(bitmap.height * scale));

    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext("2d");
    if (!ctx) {
      bitmap.close();
      return null;
    }
    ctx.drawImage(bitmap, 0, 0, width, height);
    bitmap.close();

    const blob = await new Promise<Blob | null>((resolve) =>
      canvas.toBlob(resolve, "image/webp", 0.8)
    );
    if (!blob) return null;

    const uniqueName = `webp-${Date.now()}-${crypto.randomUUID().slice(0, 8)}.webp`;
    return new File([blob], uniqueName, { type: "image/webp" });
  }

  window.addEventListener("certificate:edit", ((event: Event) => {
    const detail = (event as CustomEvent<CertEditDetail>).detail;
    editingId = detail.id;
    title.value = detail.title;
    issuer.value = detail.issuer;
    issueDate.value = detail.issueDate.slice(0, 10);
    expiryDate.value = toInput(detail.expiryDate?.slice(0, 10));
    credentialUrl.value = toInput(detail.credentialUrl);
    skills.value = (detail.skills ?? []).join(", ");
    category.value = detail.category ?? "training";
    fileInput.value = "";
    fileCurrent.textContent = detail.fileUrl
      ? `$ file saat ini: ${detail.fileUrl.split("/").pop() ?? detail.fileUrl}`
      : "";
    setMode(true);
    form.scrollIntoView({ behavior: "smooth", block: "start" });
    title.focus();
  }) as EventListener);

  cancelBtn.addEventListener("click", () => {
    editingId = null;
    form.reset();
    setMode(false);
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    statusEl.textContent = "";

    submitBtn.disabled = true;

    const payload = {
      title: title.value.trim(),
      issuer: issuer.value.trim(),
      issueDate: issueDate.value,
      expiryDate: expiryDate.value || null,
      category: category.value as "compliance" | "training",
      credentialUrl: credentialUrl.value.trim() || null,
      skills: skills.value.split(",").map((s) => s.trim()).filter(Boolean),
    };

    // File dipilih -> kirim multipart ke endpoint upload (validasi MIME
    // server-side + rollback otomatis jika INSERT/UPDATE gagal).
    const hasFile = fileInput.files && fileInput.files.length > 0;

    let res: Response;

    if (hasFile) {
      const formData = new FormData();
      let uploadFile: File = fileInput.files![0];

      // ===== Optimasi penyimpanan: PNG/JPG otomatis dikompres ke WebP =====
      // (re-encode canvas juga membuang metadata EXIF/GPS dari foto asli)
      if (uploadFile.type === "image/png" || uploadFile.type === "image/jpeg") {
        statusEl.textContent = "$ compressing image...";
        const compressed = await compressToWebp(uploadFile);
        if (compressed) {
          const reduced = Math.round((1 - compressed.size / uploadFile.size) * 100);
          sizeEl.classList.remove("hidden");
          sizeEl.textContent = `${formatBytes(uploadFile.size)} ➔ ${formatBytes(compressed.size)} (Terkoreksi ${reduced}%)`;
          uploadFile = compressed;
        }
      }

      // Nama file unik (timestamp + UUID) untuk SEMUA tipe file.
      const ext = (uploadFile.name.split(".").pop() ?? "").toLowerCase() || "bin";
      uploadFile = new File(
        [uploadFile],
        `file-${Date.now()}-${crypto.randomUUID().slice(0, 8)}.${ext}`,
        { type: uploadFile.type }
      );

      statusEl.textContent = "";
      formData.append("file", uploadFile);
      formData.append("title", payload.title);
      formData.append("issuer", payload.issuer);
      formData.append("issueDate", payload.issueDate);
      if (payload.expiryDate) formData.append("expiryDate", payload.expiryDate);
      if (payload.credentialUrl) formData.append("credentialUrl", payload.credentialUrl);
      formData.append("skills", payload.skills.join(", "));
      formData.append("category", payload.category);

      res = await fetch(
        editingId
          ? `/api/certificates/upload?id=${encodeURIComponent(editingId)}`
          : "/api/certificates/upload",
        { method: editingId ? "PUT" : "POST", body: formData }
      );
    } else {
      res = await fetch(
        editingId ? `/api/certificates?id=${encodeURIComponent(editingId)}` : "/api/certificates",
        {
          method: editingId ? "PUT" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        }
      );
    }

    const data = await res.json();

    submitBtn.disabled = false;

    if (!res.ok || !data.ok) {
      statusEl.textContent = `$ error: ${data.error ?? "gagal menyimpan"}`;
      statusEl.classList.add("text-cyber-danger");
      return;
    }

    statusEl.textContent = "$ saved — reloading...";
    statusEl.classList.remove("text-cyber-danger");
    statusEl.classList.add("text-cyber-primary");
    window.location.reload();
  });
</script>
