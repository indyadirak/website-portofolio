---
import type { ProjectsRow } from "../../lib/types";
import { getDictionary, localeFromPathname } from "../../lib/i18n";

interface Props {
  projects: ProjectsRow[];
  /** Admin/editor: boleh edit. */
  canWrite: boolean;
  /** Admin saja: boleh delete. */
  isAdmin: boolean;
}

const { projects, canWrite, isAdmin } = Astro.props;
const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<div
  class="space-y-3"
  data-i18n-confirm-delete={t.adminProjects.confirmDelete}
  data-i18n-delete-failed={t.adminProjects.deleteFailed}
>
  {
    projects.length > 0 ? (
      projects.map((project) => (
        <article
          class="flex flex-col gap-3 rounded border border-cyber-border bg-cyber-card p-5 md:flex-row md:items-center md:justify-between"
          data-project-json={JSON.stringify(project)}
        >
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-mono text-base font-bold text-white">{project.title}</h3>
              {project.featured && (
                <span class="rounded border border-cyber-primary/50 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-cyber-primary">
                  {t.adminProjects.featuredBadge}
                </span>
              )}
            </div>
            <p class="mt-1 font-mono text-xs text-cyber-muted">
              {project.category} — {project.status} — /{project.slug}
            </p>
            {
              project.problem && (
                <p class="mt-2 line-clamp-1 text-sm text-slate-400">
                  <span class="text-cyber-accent">problem:</span> {project.problem}
                </p>
              )
            }
          </div>

          <div class="flex shrink-0 items-center gap-3 font-mono text-xs">
            {
              canWrite && (
                <button
                  type="button"
                  data-action="edit"
                  class="rounded border border-cyber-border px-4 py-2 text-cyber-accent transition-colors hover:border-cyber-accent"
                >
                  {t.adminProjects.editAction}
                </button>
              )
            }
            {
              isAdmin && (
                <button
                  type="button"
                  data-action="delete"
                  class="rounded border border-cyber-danger/50 px-4 py-2 text-cyber-danger transition-colors hover:bg-cyber-danger/10"
                >
                  {t.adminProjects.deleteAction}
                </button>
              )
            }
          </div>
        </article>
      ))
    ) : (
      <p class="rounded border border-cyber-border bg-cyber-card p-8 font-mono text-sm text-cyber-muted">
        {t.adminProjects.emptyList}
      </p>
    )
  }
</div>

<script>
  const listRoot = document.querySelector("[data-i18n-confirm-delete]") as HTMLElement | null;
  const confirmDeleteTpl =
    listRoot?.dataset.i18nConfirmDelete ?? 'Hapus "{title}"? Aksi ini tidak dapat dibatalkan.';
  const deleteFailedTpl =
    listRoot?.dataset.i18nDeleteFailed ?? "Gagal menghapus: {error}";

  document.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
    const card = btn.closest<HTMLElement>("[data-project-json]");
    if (!card) return;

    const project = JSON.parse(card.dataset.projectJson ?? "null") as {
      id: string;
      slug: string;
      title: string;
      summary: string;
      description: string;
      category: string;
      tags: string[];
      image_url?: string | null;
      repo_url?: string | null;
      live_url?: string | null;
      featured: boolean;
      status: string;
      problem?: string | null;
      solution?: string | null;
      impact?: string | null;
    };

    if (btn.dataset.action === "edit") {
      btn.addEventListener("click", () => {
        window.dispatchEvent(
          new CustomEvent("project:edit", {
            detail: {
              id: project.id,
              slug: project.slug,
              title: project.title,
              summary: project.summary,
              description: project.description,
              category: project.category,
              tags: project.tags,
              imageUrl: project.image_url,
              repoUrl: project.repo_url,
              liveUrl: project.live_url,
              featured: project.featured,
              status: project.status,
              problem: project.problem,
              solution: project.solution,
              impact: project.impact,
            },
          })
        );
      });
    }

    if (btn.dataset.action === "delete") {
      btn.addEventListener("click", async () => {
        if (!window.confirm(confirmDeleteTpl.replace("{title}", project.title))) return;

        btn.disabled = true;
        const res = await fetch(`/api/projects?id=${encodeURIComponent(project.id)}`, {
          method: "DELETE",
        });
        const data = await res.json();

        if (!res.ok || !data.ok) {
          window.alert(deleteFailedTpl.replace("{error}", String(data.error ?? "unknown")));
          btn.disabled = false;
          return;
        }

        window.location.reload();
      });
    }
  });
</script>
