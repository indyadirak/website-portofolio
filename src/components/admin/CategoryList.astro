---
import type { ProjectCategoryRow } from "../../lib/types";

interface Props {
  categories: ProjectCategoryRow[];
  /** Admin dapat menghapus; editor tidak (pola canDeleteProjects). */
  canDelete: boolean;
}

const { categories, canDelete } = Astro.props;
---

{
  categories.length === 0 ? (
    <div class="rounded border border-cyber-border bg-cyber-card p-6 font-mono text-xs text-cyber-muted">
      <p>$ ls /categories --all</p>
      <p>total 0</p>
      <p>(belum ada kategori. Isi form di atas untuk membuat yang pertama.)</p>
    </div>
  ) : (
    <div class="overflow-x-auto rounded border border-cyber-border bg-cyber-card">
      <table class="w-full min-w-[640px] text-left font-mono text-sm">
        <thead class="border-b border-cyber-border/60 text-[11px] uppercase tracking-wider text-cyber-muted">
          <tr>
            <th class="px-4 py-3">#</th>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Slug</th>
            <th class="px-4 py-3">Sort</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {categories.map((c, i) => (
            <tr class="border-b border-cyber-border/40 transition-colors hover:bg-cyber-panel">
              <td class="px-4 py-3 text-cyber-muted">{String(i + 1).padStart(2, "0")}</td>
              <td class="px-4 py-3">
                <p class="font-semibold text-slate-200">{c.name}</p>
                {c.description && <p class="text-[11px] text-cyber-muted">{c.description}</p>}
              </td>
              <td class="px-4 py-3 text-cyber-muted">/{c.slug}</td>
              <td class="px-4 py-3 text-cyber-muted">{c.sort_order}</td>
              <td class="px-4 py-3">
                {c.is_active ? (
                  <span class="rounded border border-cyber-primary/50 px-2 py-0.5 text-[11px] uppercase tracking-wider text-cyber-primary">active</span>
                ) : (
                  <span class="rounded border border-cyber-border px-2 py-0.5 text-[11px] uppercase tracking-wider text-cyber-muted">inactive</span>
                )}
              </td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2 text-[11px]">
                  <button
                    type="button"
                    data-cat-edit={c.id}
                    class="rounded border border-cyber-border px-2 py-1 text-slate-300 transition-colors hover:border-cyber-accent hover:text-cyber-accent"
                  >
                    [ edit ]
                  </button>
                  {canDelete && (
                    <button
                      type="button"
                      data-cat-delete={c.id}
                      data-cat-name={c.name}
                      class="rounded border border-cyber-border px-2 py-1 text-cyber-muted transition-colors hover:border-cyber-danger hover:text-cyber-danger"
                    >
                      [ delete ]
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

<script>
  // Kirim event edit ke form kategori (diproses di halaman admin/categories).
  document.querySelectorAll<HTMLButtonElement>("[data-cat-edit]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.catEdit as string;
      const row = btn.closest("tr");
      const name = row?.querySelector("td:nth-child(2) p")?.textContent ?? "";
      const slug = row?.querySelector("td:nth-child(3)")?.textContent?.replace(/^\//, "") ?? "";
      const sort = row?.querySelector("td:nth-child(4)")?.textContent?.trim() ?? "0";
      const active = (row?.querySelector("td:nth-child(5) span")?.textContent?.trim() ?? "") === "active";

      window.dispatchEvent(
        new CustomEvent("category:edit", {
          detail: { id, name, slug, sortOrder: Number(sort) || 0, isActive: active },
        })
      );
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-cat-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.catDelete as string;
      const name = btn.dataset.catName ?? "";
      if (!window.confirm(`Hapus kategori "${name}"? Proyek yang memakai kategori ini akan kehilangan category_id (fallback ke teks).`)) return;
      btn.disabled = true;
      const res = await fetch(`/api/admin/categories?id=${encodeURIComponent(id)}`, { method: "DELETE" }).catch(() => null);
      if (res && res.ok) window.location.reload();
      else btn.disabled = false;
    });
  });
</script>