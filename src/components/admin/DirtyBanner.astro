---
import { getDirtyState } from "../../lib/deploy";
import { getDictionary, localeFromPathname } from "../../lib/i18n";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
const { user } = Astro.locals;
// Fail-safe: KV bermasalah/dev tanpa binding -> dirty=false -> tidak render.
const dirty = await getDirtyState();
---

{
  dirty.dirty && user && (
    <div
      id="dirty-banner"
      class="border-b border-cyber-accent/50 bg-cyber-accent/10 px-4 py-3 md:px-6"
      data-i18n-waiting={t.adminDirty.waiting}
      data-i18n-cooldown={t.adminDirty.cooldown}
      data-i18n-unavailable={t.adminDirty.unavailable}
      data-i18n-failed={t.adminDirty.failed}
      data-i18n-network={t.adminDirty.networkError}
    >
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2">
        <p class="font-mono text-xs text-cyber-accent">
          {"[!] "}
          {t.adminDirty.banner.replace("{count}", String(dirty.count))}
        </p>
        <button
          id="dirty-publish-btn"
          type="button"
          class="rounded border border-cyber-accent/60 bg-cyber-accent/10 px-4 py-1.5 font-mono text-xs text-cyber-accent transition-colors hover:bg-cyber-accent hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50"
        >
          {t.adminDirty.publish}
        </button>
        <p
          id="dirty-publish-status"
          role="status"
          aria-live="polite"
          class="font-mono text-xs text-cyber-muted"
        />
      </div>
    </div>
  )
}

<script>
  const banner = document.getElementById("dirty-banner");
  const publishBtn = document.getElementById(
    "dirty-publish-btn"
  ) as HTMLButtonElement | null;
  const publishStatus = document.getElementById(
    "dirty-publish-status"
  ) as HTMLParagraphElement | null;

  publishBtn?.addEventListener("click", async () => {
    if (!publishBtn || !publishStatus || !banner) return;
    publishBtn.disabled = true;
    publishStatus.textContent = "...";
    try {
      const res = await fetch("/api/admin/deploy", { method: "POST" });
      const data = (await res.json().catch(() => null)) as {
        ok?: boolean;
        deploy?: string;
        error?: string;
      } | null;
      if (data?.deploy === "triggered") {
        publishStatus.textContent = banner.dataset.i18nWaiting ?? "ok";
      } else if (data?.deploy === "cooldown") {
        publishStatus.textContent = banner.dataset.i18nCooldown ?? "cooldown";
      } else if (data?.error === "deploy_token_missing") {
        publishStatus.textContent = banner.dataset.i18nUnavailable ?? "unavailable";
      } else {
        publishStatus.textContent = banner.dataset.i18nFailed ?? "failed";
      }
    } catch {
      publishStatus.textContent = banner.dataset.i18nNetwork ?? "network error";
    }
    publishBtn.disabled = false;
  });
</script>
