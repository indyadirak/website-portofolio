---
import { getDictionary, localeFromPathname } from "../lib/i18n";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<div
  id="cv-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label={t.cv.noticeTitle}
  hidden
>
  <div class="cv-modal-backdrop absolute inset-0 bg-black/70" data-cv-close></div>
  <div class="relative w-full max-w-md rounded border border-cyber-border bg-cyber-panel shadow-2xl">
    <div class="flex items-center justify-between border-b border-cyber-border px-5 py-3">
      <p class="font-mono text-xs font-bold uppercase tracking-wider text-cyber-danger">
        {t.cv.noticeTitle}
      </p>
    </div>
    <div class="px-5 py-6">
      <p class="font-mono text-sm leading-relaxed text-slate-300">
        <span class="text-cyber-accent">$</span> info: {t.cv.noticeMessage}
      </p>
    </div>
    <div class="flex justify-end border-t border-cyber-border px-5 py-3">
      <button
        id="cv-modal-close"
        type="button"
        data-cv-close
        class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-5 py-2 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg"
      >
        {t.cv.closeLabel}
      </button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("cv-modal") as HTMLDivElement;

  function openModal(): void {
    if (!modal) return;
    modal.hidden = false;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.getElementById("cv-modal-close")?.focus();
  }

  function closeModal(): void {
    if (!modal) return;
    modal.hidden = true;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  document.addEventListener("cv:unavailable", openModal);
  modal?.querySelectorAll<HTMLElement>("[data-cv-close]").forEach((el) => {
    el.addEventListener("click", closeModal);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeModal();
  });
</script>