---
import { getDictionary, localeFromPathname } from "../lib/i18n";
import SectionHeading from "./SectionHeading.astro";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

function lineClass(row: string): string {
  if (row.startsWith("$") || row.startsWith("#") || row.startsWith("//")) return "text-cyber-primary";
  if (row.includes("status: completed")) return "text-cyber-accent";
  return "text-cyber-muted";
}
---

<section id="operations-log" class="mx-auto max-w-6xl px-4 py-16 md:px-6">
  <SectionHeading eyebrow={t.opsLog.eyebrow} title={t.opsLog.title} />

  <div class="overflow-hidden rounded-lg border border-cyber-border bg-cyber-panel shadow-[0_0_40px_rgba(102,252,241,0.05)]">
    <div class="flex items-center gap-2 border-b border-cyber-border/60 px-4 py-2.5">
      <span class="h-3 w-3 rounded-full bg-cyber-danger/80" aria-hidden="true" />
      <span class="h-3 w-3 rounded-full bg-cyber-accent/60" aria-hidden="true" />
      <span class="h-3 w-3 rounded-full bg-cyber-primary/50" aria-hidden="true" />
      <p class="ml-3 truncate font-mono text-xs text-cyber-muted">{t.opsLog.header}</p>
    </div>

    <div class="term-scroll overflow-x-auto">
      <pre class="min-w-max px-4 py-4 font-mono text-xs leading-relaxed md:text-sm">
        {
          t.opsLog.rows.map((row) => (
            <span class={`term-row block whitespace-pre ${lineClass(row)}`}>{row}</span>
          ))
        }
      </pre>
    </div>
  </div>
</section>
