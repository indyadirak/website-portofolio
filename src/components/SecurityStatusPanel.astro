---
/**
 * SP4A.4: panel "System Status" bergaya dashboard SOC — grid minimalis
 * dengan indikator operasional. Nilai status disinkronkan dengan
 * middleware.ts (HSTS + CSP benar-benar ditegakkan di setiap response).
 */
import { getDictionary, localeFromUrl } from "../lib/i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const auditFmt = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "id-ID", {
  dateStyle: "long",
});
const lastAudit = auditFmt.format(new Date());

const tiles = [
  { label: t.home.statusWebsite, value: t.home.statusWebsiteValue, live: true },
  { label: t.home.statusHttps, value: t.home.statusHttpsValue, live: false },
  { label: t.home.statusCsp, value: t.home.statusCspValue, live: false },
  { label: t.home.statusAudit, value: lastAudit, live: false },
];
---

<section class="mx-auto max-w-6xl px-4 pt-10 md:px-6" aria-label={t.home.statusTitle}>
  <div class="overflow-hidden rounded-lg border border-cyber-border bg-cyber-panel shadow-[0_0_40px_rgba(102,252,241,0.05)]">
    <div class="flex items-center gap-2 border-b border-cyber-border/60 px-4 py-2.5">
      <span class="h-3 w-3 rounded-full bg-cyber-danger/80" aria-hidden="true" />
      <span class="h-3 w-3 rounded-full bg-cyber-accent/60" aria-hidden="true" />
      <span class="h-3 w-3 rounded-full bg-cyber-primary/50" aria-hidden="true" />
      <p class="ml-3 truncate font-mono text-xs text-cyber-muted">{t.home.statusEyebrow}</p>
    </div>

    <div class="grid grid-cols-1 gap-px bg-cyber-border/30 sm:grid-cols-2 lg:grid-cols-4">
      {
        tiles.map((tile) => (
          <div class="bg-cyber-panel px-5 py-4">
            <p class="font-mono text-[11px] uppercase tracking-wider text-cyber-muted">
              {tile.label}
            </p>
            <p class="mt-1.5 flex items-center gap-2 font-mono text-sm text-emerald-400">
              {
                tile.live ? (
                  <span class="badge-pulse inline-block h-2 w-2 shrink-0 rounded-full bg-emerald-400" aria-hidden="true" />
                ) : (
                  <span aria-hidden="true">[✓]</span>
                )
              }
              <span class="truncate">{tile.value}</span>
            </p>
          </div>
        ))
      }
    </div>

    <p class="border-t border-cyber-border/60 px-4 py-2 font-mono text-[11px] text-cyber-muted">
      {t.home.statusNote}
      <a
        href={locale === "en" ? "/en/security" : "/security"}
        class="text-cyber-primary transition-opacity hover:opacity-80"
      >
        [ security → ]
      </a>
    </p>
  </div>
</section>
