---
import type { Project } from "../lib/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusColor: Record<Project["status"], string> = {
  active: "text-cyber-primary border-cyber-primary/50",
  archived: "text-cyber-muted border-cyber-border",
  planned: "text-cyber-accent border-cyber-accent/50",
};
---

<article class="group flex flex-col rounded border border-cyber-border bg-cyber-card p-6 transition-all hover:border-cyber-primary/60 hover:glow-border">
  <div class="mb-4 flex items-center justify-between">
    <span class="rounded bg-cyber-panel px-2 py-1 font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
      {project.category}
    </span>
    <span class={`rounded border px-2 py-1 font-mono text-[11px] uppercase tracking-wider ${statusColor[project.status]}`}>
      {project.status}
    </span>
  </div>

  <h3 class="font-mono text-lg font-bold text-white transition-colors group-hover:text-cyber-primary">
    {project.title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-cyber-muted">{project.summary}</p>

  <div class="mt-4 flex flex-wrap gap-2">
    {project.tags.map((tag) => (
      <span class="font-mono text-[11px] text-cyber-primary/80">#{tag}</span>
    ))}
  </div>

  <div class="mt-6 flex items-center gap-4 font-mono text-xs">
    <a
      href={`/projects/${project.slug}`}
      class="text-cyber-primary transition-opacity hover:opacity-80"
    >
      [ details ]
    </a>
    {project.repoUrl && (
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-cyber-muted transition-colors hover:text-cyber-accent"
      >
        [ repo ]
      </a>
    )}
    {project.liveUrl && (
      <a
        href={project.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-cyber-muted transition-colors hover:text-cyber-accent"
      >
        [ live ]
      </a>
    )}
  </div>
</article>
