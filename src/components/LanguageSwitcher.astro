---
import { getRelativeLocaleUrl } from "astro:i18n";
import { localeFromPathname, otherLocale } from "../lib/i18n";

// Switcher hanya dirender pada halaman publik (bukan /admin, /api).
const pathname = Astro.url.pathname;
if (pathname.startsWith("/admin") || pathname.startsWith("/api")) return; // eslint-disable-line no-unreachable

// id = default tanpa prefix ("/about" -> id), en = prefix /en/.
const current = localeFromPathname(pathname) ?? "id";
const target = otherLocale(current);

// Pertahankan halaman yang sama: "/en/projects/" -> "/projects/", "/about" -> "/en/about"
const rest = pathname.replace(/^\/(en)\//, "").replace(/\/+$/, "");
const href = getRelativeLocaleUrl(target, rest);
const title = target === "en" ? "Switch to English" : "Ganti ke Bahasa Indonesia";
---

<a
  href={href}
  title={title}
  aria-label={title}
  class="rounded border border-cyber-border px-3 py-1.5 font-mono text-xs text-slate-300 transition-colors hover:border-cyber-accent hover:text-cyber-accent"
>
  [ {target.toUpperCase()} ]
</a>
