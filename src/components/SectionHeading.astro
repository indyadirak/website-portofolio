---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10">
  {eyebrow && <p class="font-mono text-sm text-cyber-accent">{eyebrow}</p>}
  <h2 class="mt-2 font-mono text-3xl font-bold text-white">{title}</h2>
  {description && <p class="mt-3 max-w-2xl text-cyber-muted">{description}</p>}
  <div class="mt-4 h-px w-24 bg-cyber-primary/60" />
</div>
