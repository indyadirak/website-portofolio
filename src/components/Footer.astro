---
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { siteConfig } from "../lib/config";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<footer class="border-t border-cyber-border/60 bg-cyber-panel/60">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-6 md:flex-row md:px-6">
    <p class="font-mono text-xs text-cyber-muted">
      <span class="text-cyber-primary">$</span> echo "{new Date().getFullYear()} © {siteConfig.author.name} — {t.footer.rights}"
    </p>

    <div class="flex items-center gap-2 font-mono text-xs">
      <a
        href={siteConfig.contact.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.github}]
      </a>
      <a
        href={siteConfig.contact.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.linkedin}]
      </a>
    </div>
  </div>
</footer>
