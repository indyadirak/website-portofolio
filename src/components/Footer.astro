---
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { siteConfig } from "../lib/config";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const securityHref = locale === "en" ? "/en/security" : "/security";
const privacyHref = locale === "en" ? "/en/privacy" : "/privacy";
const contactHref = getRelativeLocaleUrl(locale, "contact");
const copyright = t.footer.copyright
  .replace("{year}", String(new Date().getFullYear()))
  .replace("{author}", siteConfig.author.name);
const columnLinkClass =
  "flex min-h-11 items-center rounded px-3 font-mono text-sm text-cyber-muted transition-colors hover:text-cyber-primary";
const columnHeadingClass =
  "font-mono text-xs uppercase tracking-widest text-cyber-muted";
---

<footer class="border-t border-cyber-border/60 bg-cyber-panel/60">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href={getRelativeLocaleUrl(locale, "")} class="font-mono text-lg font-bold tracking-tight text-cyber-primary glow-text">
          {siteConfig.name}<span class="text-cyber-accent">_</span>
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-cyber-muted">{t.hero.description}</p>
        <a href={contactHref} class="mt-5 inline-flex min-h-11 items-center rounded border border-cyber-primary/50 bg-cyber-primary/10 px-4 font-mono text-xs text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg">
          {t.hero.contactMe} →
        </a>
      </div>
      <div>
        <p class={columnHeadingClass}>
          <span class="text-cyber-accent">$</span> {t.footer.legalSecurity}
        </p>
        <div class="mt-2 flex flex-col">
          <a href={securityHref} class={columnLinkClass}>
            {t.footer.securityPolicy}
          </a>
          <a href={privacyHref} class={columnLinkClass}>
            {t.footer.privacyPolicy}
          </a>
        </div>
      </div>

      <div>
        <p class={columnHeadingClass}>
          <span class="text-cyber-accent">$</span> {t.footer.connect}
        </p>
        <div class="mt-2 flex flex-col">
          <a
            href={siteConfig.contact.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={columnLinkClass}
          >
            {t.footer.github}
          </a>
          <a
            href={siteConfig.contact.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={columnLinkClass}
          >
            {t.footer.linkedin}
          </a>
          <a
            href={siteConfig.blogUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={columnLinkClass}
          >
            {t.nav.blog}
          </a>
        </div>
      </div>

      <div>
        <p class="rounded border border-cyber-border/40 bg-cyber-card/50 px-3 py-2 font-mono text-xs text-cyber-primary">
          {t.footer.systemStatus}
        </p>
      </div>
    </div>

    <div class="mt-8 border-t border-cyber-border/40 pt-4">
      <p class="text-center font-mono text-xs text-cyber-muted">{copyright}</p>
    </div>
  </div>
</footer>
