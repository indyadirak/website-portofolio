---
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { siteConfig } from "../lib/config";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);
---

<footer class="border-t border-cyber-border/60 bg-cyber-panel/60">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-6 md:flex-row md:px-6">
    <p class="font-mono text-xs text-cyber-muted">
      <span class="text-cyber-primary">$</span> echo "{new Date().getFullYear()} © {siteConfig.author.name} — {t.footer.rights}"
    </p>

    <div class="flex flex-wrap items-center justify-center gap-2 font-mono text-xs">
      <a
        href={siteConfig.blogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.nav.blog}
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6v6M10 14 20 4" />
        </svg>]
      </a>
      <a
        href={siteConfig.contact.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.github}]
      </a>
      <a
        href={siteConfig.contact.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.linkedin}]
      </a>
      <a
        href={locale === "en" ? "/en/privacy" : "/privacy"}
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.privacy}]
      </a>
      <a
        href={locale === "en" ? "/en/security" : "/security"}
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.security}]
      </a>
      <a
        href={locale === "en" ? "/en/writeups" : "/writeups"}
        class="flex min-h-11 items-center rounded px-3 text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        [{t.footer.writeups}]
      </a>
    </div>
  </div>
</footer>
