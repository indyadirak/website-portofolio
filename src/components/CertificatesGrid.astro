---
import type { Certificate } from "../lib/types";
import { getDictionary, localeFromPathname } from "../lib/i18n";
import TerminalEmptyState from "./ui/TerminalEmptyState.astro";

interface Props {
  certificates: Certificate[];
}

const { certificates } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const categoryLabels: Record<"compliance" | "training", string> = {
  compliance: t.certificates.compliance,
  training: t.certificates.training,
};

/** Format bulan + tahun locale-aware: "Januari 2025" / "January 2025". */
function formatDate(value: string): string {
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return value;
  return d.toLocaleDateString(locale === "en" ? "en-US" : "id-ID", {
    year: "numeric",
    month: "long",
  });
}

/** Status masa berlaku vs hari ini: "valid" | "expired" | null. */
function expiryStatus(cert: Certificate): "valid" | "expired" | null {
  if (!cert.expiryDate) return null;
  const expiry = new Date(cert.expiryDate + "T00:00:00");
  if (Number.isNaN(expiry.getTime())) return null;
  return expiry < new Date() ? "expired" : "valid";
}

/** Keterangan singkat sesuai locale (ID/EN), null jika tidak terisi. */
function shortDescription(cert: Certificate): string | null {
  const value = locale === "en" ? cert.shortDescriptionEn : cert.shortDescriptionId;
  return value?.trim() ? value : null;
}

function expiryBadgeClasses(status: "valid" | "expired"): string {
  return status === "valid"
    ? "border-cyber-primary/50 text-cyber-primary"
    : "border-amber-400/40 text-amber-300";
}
---

{
  certificates.length === 0 ? (
    <TerminalEmptyState
      command="ls"
      directory="/certificates"
      messageId="certificates.emptyAll"
    />
  ) : (
    <>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-[11px] uppercase tracking-wider text-cyber-muted">
          $ filter:
        </span>
        <button
          type="button"
          data-cert-filter="all"
          aria-pressed="true"
          class="cert-filter-btn rounded border border-cyber-primary/60 bg-cyber-primary/10 px-4 py-2 font-mono text-xs text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg"
        >
          {t.certificates.all}
        </button>
        {(["compliance", "training"] as const).map((category) => (
          <button
            type="button"
            data-cert-filter={category}
            aria-pressed="false"
            class="cert-filter-btn rounded border border-cyber-border px-4 py-2 font-mono text-xs text-slate-300 transition-colors hover:border-cyber-accent hover:text-cyber-accent"
          >
            {categoryLabels[category]}
          </button>
        ))}
      </div>

<div id="cert-list" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {certificates.map((cert) => (
    <article
      data-cert-item
      data-category={cert.category}
      class="flex flex-col gap-3 rounded border border-cyber-border bg-cyber-card p-5"
    >
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-mono text-sm font-bold leading-snug">
          {
            cert.verificationUrl ? (
              <a
                href={cert.verificationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white transition-colors hover:text-cyber-primary"
              >
                {cert.title}
              </a>
            ) : (
              <span class="text-white">{cert.title}</span>
            )
          }
        </h3>
        <span class="flex shrink-0 items-center gap-2">
          {cert.isFeatured && (
            <span class="rounded border border-cyber-primary/50 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-cyber-primary">
              {t.certificates.featured}
            </span>
          )}
          <span
            class="rounded border border-cyber-border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-cyber-accent"
          >
            {categoryLabels[cert.category]}
          </span>
        </span>
      </div>
      {
        shortDescription(cert) && (
          <p class="line-clamp-2 text-xs leading-relaxed text-slate-300">{shortDescription(cert)}</p>
        )
      }
      <p class="font-mono text-xs text-cyber-muted">
        {cert.issuer} — {formatDate(cert.issueDate)}
      </p>
      {
        cert.credentialId && (
          <p class="-mt-1 font-mono text-[11px] text-cyber-muted">
            <span class="uppercase tracking-wider text-cyber-accent">{t.certificates.credentialId}:</span>{" "}
            <span class="text-slate-300">{cert.credentialId}</span>
          </p>
        )
      }
      {
        (() => {
          const status = expiryStatus(cert);
          return status ? (
            <p class={`w-fit rounded border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider ${expiryBadgeClasses(status)}`}>
              {status === "valid"
                ? t.certificates.validUntil.replace("{date}", formatDate(cert.expiryDate!))
                : t.certificates.expired.replace("{date}", formatDate(cert.expiryDate!))}
            </p>
          ) : null;
        })()
      }
      {cert.skills.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-2 pt-1">
          {cert.skills.map((skill) => (
            <span class="font-mono text-[11px] text-cyber-primary/80">#{skill}</span>
          ))}
        </div>
      )}
      {cert.verificationUrl && (
        <a
          href={cert.verificationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-1 rounded border border-cyber-primary/50 bg-cyber-primary/10 px-2 py-0.5 font-mono text-[11px] text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016Z" />
          </svg>
          {t.certificates.verifyCredential}
        </a>
      )}
      {cert.credentialUrl && (
        <a
          href={cert.credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-cyber-accent transition-opacity hover:opacity-80"
        >
          [ credential ]
        </a>
      )}
    </article>
  ))}
</div>

<TerminalEmptyState
  id="cert-empty"
  hidden
  messageId="certificates.empty"
/>
    </>
  )
}

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-cert-filter]");
  const items = document.querySelectorAll<HTMLElement>("[data-cert-item]");
  const emptyEl = document.getElementById("cert-empty") as HTMLElement;

  const activeClasses = ["border-cyber-primary/60", "bg-cyber-primary/10", "text-cyber-primary"];
  const idleClasses = ["border-cyber-border", "text-slate-300"];

  function applyFilter(category: string): void {
    let visible = 0;

    items.forEach((item) => {
      const match = category === "all" || item.dataset.category === category;
      item.hidden = !match;
      if (match) visible += 1;
    });

    if (emptyEl) emptyEl.hidden = visible > 0;

    buttons.forEach((btn) => {
      const active = btn.dataset.certFilter === category;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.remove(...activeClasses, ...idleClasses);
      btn.classList.add(...(active ? activeClasses : idleClasses));
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      applyFilter(btn.dataset.certFilter ?? "all");
    });
  });
</script>