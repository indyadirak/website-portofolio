---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, localeFromPathname } from "../lib/i18n";
import { siteConfig } from "../lib/config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import CvDownloadButton from "./CvDownloadButton.astro";

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const homeHref = getRelativeLocaleUrl(locale, "");
const navLinks = [
  { label: t.nav.home, href: homeHref },
  { label: t.nav.projects, href: getRelativeLocaleUrl(locale, "projects") },
  { label: t.nav.writeups, href: getRelativeLocaleUrl(locale, "writeups") },
  { label: t.nav.certificates, href: getRelativeLocaleUrl(locale, "certificates") },
  { label: t.nav.about, href: getRelativeLocaleUrl(locale, "about") },
  { label: t.nav.contact, href: getRelativeLocaleUrl(locale, "contact") },
];
const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  const normalized = normalizePath(href);
  return currentPath === normalized || currentPath.startsWith(normalized + "/");
};
const linkClass =
  "flex min-h-11 items-center rounded px-3 font-mono text-sm transition-colors";
const menuId = "site-menu";
const btnId = "menu-toggle";
const blogUrl = siteConfig.blogUrl;
---

<header class="glass sticky top-0 z-50">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-2 md:px-6">
    <a
      href={homeHref}
      class="flex min-h-11 items-center font-mono text-base font-bold tracking-tight text-cyber-primary glow-text md:text-lg"
    >
      {siteConfig.name}
      <span class="text-cyber-accent">_</span>
    </a>

    <div class="hidden items-center gap-2 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class={`${linkClass} ${
              isActive(link.href)
                ? "text-cyber-primary"
                : "text-cyber-muted hover:text-cyber-primary"
            }`}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={blogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center gap-1.5 rounded px-3 font-mono text-sm text-cyber-muted transition-colors hover:text-cyber-primary"
      >
        {t.nav.blog}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6v6M10 14 20 4" />
        </svg>
      </a>
      <CvDownloadButton variant="nav" />
      <LanguageSwitcher />
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <LanguageSwitcher />
      <button
        id={btnId}
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls={menuId}
        class="flex h-11 w-11 items-center justify-center rounded border border-cyber-border text-cyber-primary transition-colors hover:border-cyber-primary/50"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id={menuId} class="hidden border-t border-cyber-border/60 bg-cyber-bg/95 backdrop-blur-xl lg:hidden">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class={`${linkClass} ${
              isActive(link.href)
                ? "text-cyber-primary hover:text-cyber-primary"
                : "text-cyber-muted hover:bg-cyber-card hover:text-cyber-primary"
            }`}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={blogUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center gap-1.5 rounded px-3 font-mono text-sm text-cyber-muted transition-colors hover:bg-cyber-card hover:text-cyber-primary"
      >
        {t.nav.blog}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6v6M10 14 20 4" />
        </svg>
      </a>
      <CvDownloadButton variant="nav" />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("site-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!isOpen));
      iconOpen?.classList.toggle("hidden", !isOpen);
      iconClose?.classList.toggle("hidden", isOpen);
    });
  }
</script>
