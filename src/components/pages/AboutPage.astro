---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import EmailLink from "../EmailLink.astro";
import CtaSection from "../CtaSection.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { siteConfig } from "../../lib/config";
import { getExperiences } from "../../lib/data/experiences";
import { getSocialLinks } from "../../lib/data/social-links";
import { getSiteSettingValue } from "../../lib/data/site-settings";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const { author, contact } = siteConfig;
const availabilityStatus =
  (await getSiteSettingValue("availability_status")) ?? contact.availabilityStatus;
const available = availabilityStatus !== "not-available";

const experiences = await getExperiences();
const socialLinks = await getSocialLinks();
const aboutBio = (await getSiteSettingValue("about_bio"))?.trim();
const aboutContactInfo = (await getSiteSettingValue("about_contact_info"))?.trim();
let specializations = t.about.specializations;
try {
  const configured = JSON.parse((await getSiteSettingValue("about_specializations")) ?? "[]");
  if (Array.isArray(configured) && configured.every((item) => typeof item === "string")) {
    specializations = configured.filter(Boolean);
  }
} catch {
  specializations = t.about.specializations;
}

/** Format periode terminal: "2024-03" -> "2024/03". */
const fmtDate = (d: string) => (d ? d.slice(0, 7).replace("-", "/") : "????/??");
const hostOf = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<MainLayout title={t.about.title} description={t.meta.about}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <SectionHeading eyebrow={t.about.eyebrow} title={t.about.title} />

    <div class="space-y-6 leading-relaxed text-slate-300">
        <p class="font-sans text-base leading-relaxed">
        <strong class="text-cyber-primary">{author.name}</strong> —{" "}
        {aboutBio || t.about.paragraphs[0]}
      </p>
      {!aboutBio && <p class="font-sans text-base leading-relaxed">{t.about.paragraphs[1]}</p>}
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded border border-cyber-border bg-cyber-card p-6">
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {t.about.specializationsTitle}
        </h2>
        <ul class="mt-4 space-y-2 font-mono text-sm text-slate-300">
          {specializations.map((item) => (
            <li class="inline-block rounded border border-cyber-border px-2 py-1 text-xs text-cyber-primary">
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded border border-cyber-border bg-cyber-card p-6">
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {t.about.contactTitle}
        </h2>
        <ul class="mt-4 space-y-2 font-mono text-sm text-slate-300">
          {aboutContactInfo && <li class="font-sans whitespace-pre-line leading-relaxed text-slate-300">{aboutContactInfo}</li>}
          <li>
            {t.about.emailLabel}: <EmailLink />
          </li>
          {socialLinks.length > 0 ? (
            socialLinks.map((link) => (
              <li>
                  <span class="text-cyber-muted">{link.platform}:</span>{" "}
                  <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cyber-primary hover:underline"
                  >
                    {link.icon?.startsWith("http://") || link.icon?.startsWith("https://") ? (
                      <img
                        src={link.icon}
                        alt=""
                        width="16"
                        height="16"
                        loading="lazy"
                        class="mr-1 inline-block h-4 w-4 object-contain align-text-bottom"
                      />
                    ) : link.icon ? (
                      <i class={`${link.icon} mr-1`} aria-hidden="true"></i>
                    ) : null}
                    {hostOf(link.url)}
                  </a>
              </li>
            ))
          ) : (
            <>
              <li>
                <span class="text-cyber-muted">{t.about.githubLabel}:</span>{" "}
                <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer" class="text-cyber-primary hover:underline">
                  {hostOf(contact.githubUrl)}
                </a>
              </li>
              <li>
                <span class="text-cyber-muted">{t.about.linkedinLabel}:</span>{" "}
                <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-cyber-primary hover:underline">
                  {hostOf(contact.linkedinUrl)}
                </a>
              </li>
            </>
          )}
          <li class="pt-2">
            {t.about.availabilityLabel}:{" "}
            <span class={available ? "text-cyber-primary" : "text-cyber-danger"}>
              {available ? t.about.openToWork : t.about.notAvailable}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-6 rounded border border-cyber-primary/40 bg-cyber-primary/5 p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="font-mono text-sm font-bold text-cyber-primary">
            {t.cv.aboutCtaTitle}
          </h2>
          <p class="mt-1 font-mono text-xs leading-relaxed text-cyber-muted">
            {t.cv.aboutCtaDescription}
          </p>
        </div>
        <a
          href={getRelativeLocaleUrl(locale, "security-cv")}
          aria-label={t.cv.securityCv.title}
          class="inline-flex min-h-11 shrink-0 items-center rounded border border-cyber-primary/60 px-4 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg"
        >
          {t.cv.aboutCtaButton}
        </a>
      </div>
    </div>

    <section class="mt-12">
      <SectionHeading eyebrow={t.about.timelineEyebrow} title={t.about.timelineTitle} />
      {experiences.length === 0 ? (
        <p class="font-mono text-xs text-cyber-muted">{t.about.timelineEmpty}</p>
      ) : (
        <ol class="mt-8">
          {(() => {
            let previousCompany = "";
            return experiences.map((exp) => {
              const nested = previousCompany === exp.company;
              previousCompany = exp.company;
              return (
            <li class:list={[
              "relative pb-10 last:pb-0",
              nested ? "ml-5 border-l border-dashed border-cyber-accent/40 pl-6" : "border-l border-cyber-border/40 pl-6",
            ]}>
              <span
                aria-hidden="true"
                class:list={[
                  "absolute top-1.5 h-2.5 w-2.5 rounded-full border bg-cyber-bg",
                  nested ? "-left-[5px] border-cyber-accent" : "-left-[5px] border-cyber-primary",
                ]}
              />
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-mono text-sm font-bold text-cyber-primary md:text-base">{exp.role}</h3>
                <span class="font-mono text-xs text-cyber-muted">{exp.company}</span>
              </div>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
                [ {fmtDate(exp.startDate)} {"->"}
                {exp.isCurrent ? (
                  <span class="text-cyber-primary">{t.about.periodNow}</span>
                ) : (
                  fmtDate(exp.endDate ?? "")
                )}{" "}
                ]
              </p>
              {exp.description && (
                <p class="mt-2 max-w-2xl font-sans text-sm leading-relaxed text-slate-300">{exp.description}</p>
              )}
            </li>
              );
            });
          })()}
        </ol>
      )}
    </section>
  </div>

  <CtaSection />
</MainLayout>
