---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import EmailLink from "../EmailLink.astro";
import CtaSection from "../CtaSection.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";
import { siteConfig } from "../../lib/config";
import { getExperiences } from "../../lib/data/experiences";
import { getSocialLinks } from "../../lib/data/social-links";
import { getSiteSettingValue } from "../../lib/data/site-settings";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const { author, contact } = siteConfig;
const availabilityStatus =
  (await getSiteSettingValue("availability_status")) ?? contact.availabilityStatus;
const available = availabilityStatus !== "not-available";

const experiences = await getExperiences();
const socialLinks = await getSocialLinks();

/** Format periode terminal: "2024-03" -> "2024/03". */
const fmtDate = (d: string) => (d ? d.slice(0, 7).replace("-", "/") : "????/??");
const hostOf = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<MainLayout title={t.about.title} description={t.meta.about}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <SectionHeading eyebrow={t.about.eyebrow} title={t.about.title} />

    <div class="space-y-6 leading-relaxed text-slate-300">
      <p>
        <strong class="text-cyber-primary">{author.name}</strong> —{" "}
        {t.about.paragraphs[0]}
      </p>
      <p>{t.about.paragraphs[1]}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded border border-cyber-border bg-cyber-card p-6">
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {t.about.specializationsTitle}
        </h2>
        <ul class="mt-4 space-y-2 font-mono text-sm text-slate-300">
          {t.about.specializations.map((item, index) => (
            <li class={index === 0 ? "text-cyber-primary" : ""}>{item}</li>
          ))}
        </ul>
      </div>

      <div class="rounded border border-cyber-border bg-cyber-card p-6">
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {t.about.contactTitle}
        </h2>
        <ul class="mt-4 space-y-2 font-mono text-sm text-slate-300">
          <li>
            {t.about.emailLabel}: <EmailLink />
          </li>
          {socialLinks.length > 0 ? (
            socialLinks.map((link) => (
              <li>
                  <span class="text-cyber-muted">{link.platform}:</span>{" "}
                  <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cyber-primary hover:underline"
                  >
                    {link.icon?.startsWith("http://") || link.icon?.startsWith("https://") ? (
                      <img
                        src={link.icon}
                        alt=""
                        width="16"
                        height="16"
                        loading="lazy"
                        class="mr-1 inline-block h-4 w-4 object-contain align-text-bottom"
                      />
                    ) : link.icon ? (
                      <i class={`${link.icon} mr-1`} aria-hidden="true"></i>
                    ) : null}
                    {hostOf(link.url)}
                  </a>
              </li>
            ))
          ) : (
            <>
              <li>
                <span class="text-cyber-muted">{t.about.githubLabel}:</span>{" "}
                <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer" class="text-cyber-primary hover:underline">
                  {hostOf(contact.githubUrl)}
                </a>
              </li>
              <li>
                <span class="text-cyber-muted">{t.about.linkedinLabel}:</span>{" "}
                <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-cyber-primary hover:underline">
                  {hostOf(contact.linkedinUrl)}
                </a>
              </li>
            </>
          )}
          <li class="pt-2">
            {t.about.availabilityLabel}:{" "}
            <span class={available ? "text-cyber-primary" : "text-cyber-danger"}>
              {available ? t.about.openToWork : t.about.notAvailable}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <section class="mt-12">
      <SectionHeading eyebrow={t.about.timelineEyebrow} title={t.about.timelineTitle} />
      {experiences.length === 0 ? (
        <p class="font-mono text-xs text-cyber-muted">{t.about.timelineEmpty}</p>
      ) : (
        <ol class="mt-8">
          {experiences.map((exp) => (
            <li class="relative border-l border-cyber-border/40 pb-10 pl-6 last:pb-0">
              <span
                aria-hidden="true"
                class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border border-cyber-primary bg-cyber-bg"
              />
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-mono text-sm font-bold text-cyber-primary md:text-base">{exp.role}</h3>
                <span class="font-mono text-xs text-cyber-muted">{exp.company}</span>
              </div>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
                [ {fmtDate(exp.startDate)} {"->"}
                {exp.isCurrent ? (
                  <span class="text-cyber-primary">{t.about.periodNow}</span>
                ) : (
                  fmtDate(exp.endDate ?? "")
                )}{" "}
                ]
              </p>
              {exp.description && (
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-300">{exp.description}</p>
              )}
            </li>
          ))}
        </ol>
      )}
    </section>
  </div>

  <CtaSection />
</MainLayout>
