---
/**
 * SP4C.1: "Security CV" — ringkasan profesional siap cetak (/security-cv).
 * Sumber data sama dengan portofolio live (site_settings, certificates,
 * skills, experiences) sehingga dokumen tidak pernah busuk terpisah.
 * Cetak/simpan-PDF lewat dialog browser; global.css sudah menormalkan
 * tema gelap ke putih-hitam saat print.
 */
import MainLayout from "../../layouts/MainLayout.astro";
import EmailLink from "../EmailLink.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";
import { siteConfig } from "../../lib/config";
import { getSiteSettingValue } from "../../lib/data/site-settings";
import { getCertificates } from "../../lib/data/certificates";
import { getSkills } from "../../lib/data/skills";
import { getExperiences } from "../../lib/data/experiences";
import type { SkillCategory } from "../../lib/types";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);
const cv = t.cv.securityCv;

const { author, contact } = siteConfig;
const role = (await getSiteSettingValue("hero_tagline"))?.trim() || t.hero.role;
const summary = (await getSiteSettingValue("short_bio"))?.trim() || t.about.paragraphs[0];
const availabilityStatus =
  (await getSiteSettingValue("availability_status")) ?? contact.availabilityStatus;
const available = availabilityStatus !== "not-available";

const certificates = await getCertificates();
const skills = await getSkills();
const experiences = (await getExperiences()).slice(0, 4);

const categoryOrder: SkillCategory[] = [
  "Defensive",
  "Network",
  "Offensive",
  "Forensics",
  "Tools",
  "Programming",
  "Soft Skill",
];
const categoryLabels: Record<SkillCategory, string> = {
  Defensive: t.skills.categories.defensive,
  Network: t.skills.categories.network,
  Offensive: t.skills.categories.offensive,
  Forensics: t.skills.categories.forensics,
  Tools: t.skills.categories.tools,
  Programming: t.skills.categories.programming,
  "Soft Skill": t.skills.categories.softSkill,
};
const groupedSkills = categoryOrder
  .map((category) => ({
    category,
    items: skills.filter((skill) => skill.category === category),
  }))
  .filter((group) => group.items.length > 0);

const fmtYear = (d: string) => d.slice(0, 4);
const host = (url: string) => url.replace(/^https?:\/\//, "");
const backHref = locale === "en" ? "/en/about" : "/about";

function renderDiagramLine(line: string): string {
  const box = line.match(/^(\s*)(\[)([^\]]*)(\])(.*)$/);
  if (box) {
    const [, indent, open, label, close, rest] = box;
    return `${indent}<span class="text-cyber-primary">${open}</span><span class="text-slate-200">${label}</span><span class="text-cyber-primary">${close}</span><span class="text-cyber-muted">${rest}</span>`;
  }
  return `<span class="text-cyber-muted">${line}</span>`;
}
---

<MainLayout title={cv.title} description={cv.description}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <!-- Action bar — tersembunyi saat cetak -->
    <div class="mb-8 flex flex-wrap items-center gap-4 print:hidden">
      <a
        href={backHref}
        class="font-mono text-xs text-cyber-muted transition-colors hover:text-cyber-primary"
      >
        [ cd ../about ]
      </a>
      <span class="flex-1"></span>
      <button
        id="cv-print-btn"
        type="button"
        aria-label={cv.printLabel}
        class="inline-flex min-h-11 items-center rounded border border-cyber-primary/60 bg-cyber-primary/10 px-5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg"
      >
        {cv.printLabel}
      </button>
    </div>
    <p class="mb-10 font-mono text-[11px] text-cyber-muted print:hidden">
      $ {cv.printHint}
    </p>

    <!-- ===== LEMBAR CV ===== -->
    <article class="rounded border border-cyber-border bg-cyber-card p-8 md:p-10">
      <header class="border-b border-cyber-border/60 pb-6">
        <h1 class="font-mono text-2xl font-bold text-white md:text-3xl">
          {author.name}<span class="text-cyber-primary">;</span>
        </h1>
        <p class="mt-1 font-mono text-sm text-cyber-primary">{role}</p>
        <p class="mt-3 font-mono text-xs text-cyber-muted">
          <EmailLink /> | {host(contact.githubUrl)} | {host(contact.linkedinUrl)} |{" "}
          {host(siteConfig.url)}
        </p>
        <p class="mt-1 font-mono text-xs">
          <span class="text-cyber-muted">availability:</span>{" "}
          <span class={available ? "text-cyber-primary" : "text-cyber-danger"}>
            {available ? t.about.openToWork : t.about.notAvailable}
          </span>
        </p>
      </header>

      <section class="mt-8">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyber-accent">
          ## {cv.summaryTitle}
        </h2>
        <p class="mt-2 font-mono text-sm leading-relaxed text-slate-200">{summary}</p>
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyber-accent">
          ## {cv.certTitle}
        </h2>
        {
          certificates.length === 0 ? (
            <p class="mt-2 font-mono text-xs text-cyber-muted">{cv.certEmpty}</p>
          ) : (
            <ul class="mt-3 space-y-3">
              {certificates.map((cert) => (
                <li class="font-mono text-sm">
                  <span class="text-slate-200">{cert.title}</span>
                  <span class="text-cyber-muted">
                    {" "}<span aria-hidden="true">—</span> {cert.issuer},{" "}
                    {fmtYear(cert.issueDate)}
                    {cert.expiryDate ? `–${fmtYear(cert.expiryDate)}` : ""}
                  </span>
                  {cert.credentialId && (
                    <span class="mt-0.5 block text-[11px] text-cyber-muted">
                      {cv.credentialLabel}:{" "}
                      <span class="text-cyber-primary">{cert.credentialId}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyber-accent">
          ## {cv.homeLabTitle}
        </h2>
        <pre
          class="writeup-code-block mt-3"
          set:html={cv.homeLabDiagram.map(renderDiagramLine).join("\n")}
        ></pre>
        <p class="mt-2 font-mono text-[11px] text-cyber-muted">{cv.homeLabNote}</p>
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyber-accent">
          ## {cv.skillsTitle}
        </h2>
        <dl class="mt-3 space-y-2">
          {
            groupedSkills.map((group) => (
              <div class="flex flex-wrap items-baseline gap-x-2">
                <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-cyber-primary">
                  {categoryLabels[group.category]}:
                </dt>
                <dd class="flex flex-1 flex-wrap gap-x-3 font-mono text-sm text-slate-200">
                  {group.items.map((skill) => (
                    <span>{skill.name}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="mt-8">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-cyber-accent">
          ## {cv.experienceTitle}
        </h2>
        {
          experiences.length === 0 ? (
            <p class="mt-2 font-mono text-xs text-cyber-muted">{cv.experienceEmpty}</p>
          ) : (
            <ul class="mt-3 space-y-3">
              {experiences.map((exp) => (
                <li class="font-mono text-sm">
                  <span class="text-slate-200">{exp.role}</span>
                  <span class="text-cyber-muted">
                    {" "}<span aria-hidden="true">—</span> {exp.company} (
                    {exp.startDate.slice(0, 4)}
                    {exp.isCurrent ? "–now" : `–${exp.endDate?.slice(0, 4) ?? "?"}`})
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <footer class="mt-10 border-t border-cyber-border/60 pt-4">
        <p class="font-mono text-[11px] leading-relaxed text-cyber-muted">
          {cv.footerNote}
        </p>
      </footer>
    </article>
  </div>
</MainLayout>

<script>
  const btn = document.getElementById("cv-print-btn");
  btn?.addEventListener("click", () => window.print());
</script>
