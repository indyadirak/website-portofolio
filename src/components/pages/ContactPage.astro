---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import ContactForm from "../ContactForm.astro";
import EmailLink from "../EmailLink.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";
import { siteConfig } from "../../lib/config";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);
---

<MainLayout
  title={t.contact.title}
  description={t.meta.contact}
>
  <div class="reveal mx-auto max-w-3xl px-6 py-16">
    <SectionHeading
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      description={t.contact.description}
    />

    <div class="rounded border border-cyber-border bg-cyber-panel p-6 md:p-8">
      <ContactForm />
    </div>

    <div class="mt-6 rounded border border-cyber-border bg-cyber-card p-6">
      <p class="font-mono text-sm text-cyber-accent">{t.contact.directEmailTitle}</p>
      <p class="mt-3 font-mono text-sm text-slate-300">
        <EmailLink /> <span class="text-cyber-muted">— {t.contact.orVia} </span>
        <a href={siteConfig.contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-cyber-accent hover:underline">
          LinkedIn
        </a>
      </p>
    </div>

    <div class="mt-6 rounded border border-cyber-border bg-cyber-card p-6">
      <p class="font-mono text-sm text-cyber-accent">{t.contact.pgpTitle}</p>
      <p class="mt-2 font-mono text-sm leading-relaxed text-cyber-muted">
        {t.contact.pgpDescription}
      </p>
      <dl class="mt-4 space-y-1 font-mono text-xs">
        <div class="flex flex-wrap items-baseline gap-x-2">
          <dt class="uppercase tracking-wider text-cyber-muted">{t.contact.pgpFingerprintLabel}:</dt>
          <dd class="break-all text-cyber-primary">{siteConfig.security.pgpFingerprint}</dd>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-2">
          <dt class="uppercase tracking-wider text-cyber-muted">{t.contact.pgpKeyIdLabel}:</dt>
          <dd class="text-cyber-primary">{siteConfig.security.pgpKeyId}</dd>
        </div>
      </dl>
      <a
        href={siteConfig.security.pgpKeyUrl}
        download="pgp.asc"
        class="mt-4 inline-flex min-h-11 items-center rounded border border-cyber-primary/50 px-4 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary/10"
      >
        {t.contact.pgpDownload}
      </a>
    </div>

    <p class="mt-6 font-mono text-xs text-cyber-muted">
      $ note: {t.contact.note}
    </p>
  </div>
</MainLayout>
