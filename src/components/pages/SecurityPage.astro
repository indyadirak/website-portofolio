---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

function escapeHtml(line: string): string {
  return line.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

/** Warna monospace untuk diagram ASCII: box & panah di-accent, label polos. */
function renderDiagramLine(line: string): string {
  const safe = escapeHtml(line);
  const box = safe.match(/^(\s*)(\[)([^\]]*)(\])(.*)$/);
  if (box) {
    const [, indent, open, label, close, rest] = box;
    return `${indent}<span class="text-cyber-primary">${open}</span><span class="text-slate-200">${label}</span><span class="text-cyber-primary">${close}</span><span class="text-cyber-muted">${rest}</span>`;
  }
  const arrow = safe.match(/^(\s*)([|v]+)(.*)$/);
  if (arrow) {
    const [, indent, glyph, rest] = arrow;
    return `${indent}<span class="text-cyber-accent">${glyph}</span><span class="text-cyber-muted">${rest}</span>`;
  }
  return `<span class="text-cyber-muted">${safe}</span>`;
}

const implSections = [
  { title: t.security.sections.architectureTitle, items: t.security.sections.architecture },
  { title: t.security.sections.headersTitle, items: t.security.sections.headers },
  { title: t.security.sections.authenticationTitle, items: t.security.sections.authentication },
  { title: t.security.sections.dataProtectionTitle, items: t.security.sections.dataProtection },
  { title: t.security.sections.decisionsTitle, items: t.security.sections.decisions },
  { title: t.security.sections.threatModelTitle, items: t.security.sections.threatModel },
];

const disclosureCards = [
  { title: t.security.scopeTitle, items: t.security.scope },
  { title: t.security.outOfScopeTitle, items: t.security.outOfScope },
  { title: t.security.safeHarborTitle, items: t.security.safeHarbor },
];

const panelClass = "rounded border border-cyber-border bg-cyber-card p-6 md:p-8";
const panelTitleClass = "font-mono text-sm text-cyber-accent";
---

<MainLayout title={t.security.title} description={t.security.description}>
  <div class="mx-auto max-w-4xl px-6 py-16">
    <SectionHeading
      eyebrow={t.security.eyebrow}
      title={t.security.title}
      description={t.security.lastUpdated}
    />

    <div class="mt-8 space-y-6">
      <!-- 1. Defense-in-depth diagram -->
      <section class="overflow-hidden rounded border border-cyber-border bg-cyber-panel">
        <div class="flex items-center gap-2 border-b border-cyber-border/60 px-4 py-2.5">
          <span class="h-3 w-3 rounded-full bg-cyber-danger/80" aria-hidden="true" />
          <span class="h-3 w-3 rounded-full bg-cyber-accent/60" aria-hidden="true" />
          <span class="h-3 w-3 rounded-full bg-cyber-primary/50" aria-hidden="true" />
          <p class="ml-3 truncate font-mono text-xs text-cyber-muted">$ traceroute --defense-in-depth</p>
        </div>
        <div class="p-6 md:p-8">
          <p class={panelTitleClass}>{t.security.diagramTitle}</p>
          <pre
            class="term-scroll mt-4 overflow-x-auto font-mono text-[13px] leading-6 text-slate-300"
            set:html={t.security.diagram.map(renderDiagramLine).join("\n")}
          ></pre>
        </div>
      </section>

      <!-- 2. Security controls table -->
      <section class={panelClass}>
        <p class={panelTitleClass}>{t.security.controlsTitle}</p>
        <div class="term-scroll mt-4 overflow-x-auto">
          <table class="w-full min-w-[560px] border-collapse font-mono text-sm">
            <thead>
              <tr class="border-b border-cyber-border/60 text-left text-[11px] uppercase tracking-wider text-cyber-muted">
                <th class="py-2 pr-4 font-normal">control</th>
                <th class="py-2 pr-4 font-normal">status</th>
                <th class="py-2 font-normal">implementation</th>
              </tr>
            </thead>
            <tbody>
              {
                t.security.controls.map((control) => (
                  <tr class="border-b border-cyber-border/30 last:border-0">
                    <td class="py-2.5 pr-4 text-slate-200">{control.name}</td>
                    <td class="whitespace-nowrap py-2.5 pr-4 text-emerald-400">
                      [✓] {control.status}
                    </td>
                    <td class="py-2.5 text-cyber-muted">{control.detail}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3. Implementation details -->
      <section>
        <h2 class="font-mono text-lg font-bold text-white">
          <span class="text-cyber-accent">##</span> {t.security.implementationTitle}
        </h2>
        <div class="mt-4 space-y-4">
          {
            implSections.map((section) => (
              <div class="rounded border border-cyber-border bg-cyber-card p-6">
                <p class="font-mono text-sm text-cyber-accent">{section.title}</p>
                <ul class="mt-3 space-y-2 font-mono text-sm text-slate-300">
                  {section.items.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-cyber-primary">$</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 4. Responsible disclosure -->
      <section class={panelClass}>
        <p class={panelTitleClass}>{t.security.disclosureTitle}</p>
        <p class="mt-3 font-mono text-sm leading-relaxed text-cyber-muted">
          {t.security.disclosureIntro}
        </p>

        <div class="mt-6 rounded border border-cyber-primary/40 bg-cyber-primary/5 p-4">
          <p class="font-mono text-xs uppercase tracking-wider text-cyber-primary">
            {t.security.responseTitle}
          </p>
          <p class="mt-2 font-mono text-sm text-slate-200">{t.security.responseTime}</p>
        </div>

        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {
            disclosureCards.map((card) => (
              <div>
                <p class="font-mono text-xs uppercase tracking-wider text-cyber-accent">
                  {card.title}
                </p>
                <ul class="mt-2 space-y-1.5 font-mono text-sm text-slate-300">
                  {card.items.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-cyber-accent">-</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <p class="mt-8 font-mono text-xs uppercase tracking-wider text-cyber-primary">
          $ {t.security.channelsTitle}
        </p>
        <ul class="mt-2 space-y-2 font-mono text-sm text-slate-300">
          {
            t.security.channels.map((channel) => (
              <li class="flex gap-2">
                <span class="text-cyber-accent">→</span>
                <span>{channel}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</MainLayout>
