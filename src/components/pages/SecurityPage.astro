---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const sections = [
  { title: t.security.sections.architectureTitle, items: t.security.sections.architecture },
  { title: t.security.sections.headersTitle, items: t.security.sections.headers },
  { title: t.security.sections.authenticationTitle, items: t.security.sections.authentication },
  { title: t.security.sections.dataProtectionTitle, items: t.security.sections.dataProtection },
  { title: t.security.sections.decisionsTitle, items: t.security.sections.decisions },
  { title: t.security.sections.threatModelTitle, items: t.security.sections.threatModel },
  { title: t.security.sections.disclosureTitle, items: t.security.sections.disclosure },
];
---

<MainLayout title={t.security.title} description={t.security.eyebrow}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <SectionHeading
      eyebrow={t.security.eyebrow}
      title={t.security.title}
      description={t.security.lastUpdated}
    />

    <div class="mt-8 space-y-6">
      {
        sections.map((section) => (
          <div class="rounded border border-cyber-border bg-cyber-card p-6 md:p-8">
            <p class="font-mono text-sm text-cyber-accent">{section.title}</p>
            <ul class="mt-3 space-y-2 font-mono text-sm text-slate-300">
              {section.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-cyber-primary">$</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</MainLayout>