---
import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "../Hero.astro";
import SectionHeading from "../SectionHeading.astro";
import ProjectGrid from "../ProjectGrid.astro";
import SkillGrid from "../SkillGrid.astro";
import CtaSection from "../CtaSection.astro";
import InteractiveTerminal from "../InteractiveTerminal.astro";
import { getProjects } from "../../lib/data/projects";
import { getSkills } from "../../lib/data/skills";
import { getDictionary, localeFromUrl } from "../../lib/i18n";
import { siteConfig } from "../../lib/config";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const featuredProjects = await getProjects({ featuredOnly: true });
const skills = await getSkills();

/** Data ringkas untuk terminal interaktif (disuntik via data-attributes). */
const termProjects = featuredProjects.map((p) => ({ title: p.title, slug: p.slug }));
const termSkills = skills.map((s) => ({ name: s.name, category: s.category }));
---

<MainLayout title={siteConfig.name} description={t.meta.home}>
  <Hero />

  <section id="expertise" class="reveal mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow={t.pillars.eyebrow}
      title={t.pillars.title}
      description={t.pillars.description}
    />
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {t.pillars.items.map((item, i) => (
        <article class="rounded border border-cyber-border bg-cyber-card p-6 transition-all hover:border-cyber-primary/60 hover:glow-border">
          <p class="font-mono text-4xl font-bold text-cyber-accent" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-3 font-mono text-base font-bold text-white">{item.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-cyber-muted">{item.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="reveal mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow={t.home.featuredEyebrow}
      title={t.home.featuredTitle}
      description={t.home.featuredDescription}
    />
    <ProjectGrid projects={featuredProjects} />
    <div class="mt-8">
      <a href={getRelativeLocaleUrl(locale, "projects")} class="font-mono text-sm text-cyber-primary transition-opacity hover:opacity-80">
        {t.home.viewAllProjects}
      </a>
    </div>
  </section>

  <section id="skills" class="reveal mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow={t.home.skillsEyebrow}
      title={t.home.skillsTitle}
      description={t.home.skillsDescription}
    />
    <SkillGrid skills={skills} />
  </section>

  <InteractiveTerminal
    projects={termProjects}
    skills={termSkills}
    writeupsUrl={getRelativeLocaleUrl(locale, "writeups")}
    contactUrl={getRelativeLocaleUrl(locale, "contact")}
  />

  <CtaSection />
</MainLayout>
