---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import ProjectGrid from "../ProjectGrid.astro";
import TerminalEmptyState from "../ui/TerminalEmptyState.astro";
import { getProjects, getProjectCategories } from "../../lib/data/projects";
import { getDictionary, localeFromUrl } from "../../lib/i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const projects = await getProjects();
// Kategori aktif utk filter charter (B2: dinamis dari project_categories).
const categories = await getProjectCategories();

// Featured vs secondary: kolom `featured` (boolean) pada tabel projects.
const featuredProjects = projects.filter((p) => p.featured);
const secondaryProjects = projects.filter((p) => !p.featured);
---

<MainLayout title={t.projects.title} description={t.meta.projects}>
  <div class="reveal mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow={t.projects.eyebrow}
      title={t.projects.title}
      description={t.projects.description}
    />

    {
      projects.length === 0 ? (
        <TerminalEmptyState
          class="mt-12"
          command="ls"
          directory="/projects"
          messageId="projects.noProjects"
        />
      ) : (
        <>
          <!-- B2: filter kategori dinamis (client-side, tanpa reload) -->
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs uppercase tracking-wider text-cyber-muted">
              {t.projects.filterLabel}
            </span>
            <button
              type="button"
              data-filter-all
              aria-pressed="true"
              class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-3 py-1 font-mono text-xs text-cyber-primary transition hover:bg-cyber-primary/20"
            >
              {t.projects.allCategories}
            </button>
            {
              categories.map((c) => (
                <button
                  type="button"
                  data-filter={c.name}
                  aria-pressed="false"
                  class="rounded border border-cyber-border px-3 py-1 font-mono text-xs text-cyber-muted transition hover:border-cyber-primary/60 hover:text-cyber-primary"
                >
                  {c.name}
                </button>
              ))
            }
          </div>

          <TerminalEmptyState
            id="filter-empty"
            class="mt-12"
            hidden
            messageId="projects.categoryEmpty"
          />

          <ProjectGrid projects={featuredProjects} />

          {
            secondaryProjects.length > 0 && (
              <details class="soc-details mt-16 rounded border border-cyber-border bg-cyber-card p-6">
                <summary class="flex min-h-11 flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-lg font-bold text-white">
                    {t.projects.secondaryTitle}
                  </span>
                  <span class="font-mono text-xs text-cyber-accent">
                    <span data-details-label data-open={t.projects.collapseSecondary} data-closed={t.projects.expandSecondary}>
                      {t.projects.expandSecondary}
                    </span>
                    <span class="font-mono text-xs text-cyber-muted">
                      ({secondaryProjects.length})
                    </span>
                  </span>
                </summary>

                <div class="soc-details-content mt-6">
                  <p class="mb-6 text-sm leading-relaxed text-cyber-muted">
                    {t.projects.secondaryDescription}
                  </p>
                  <ProjectGrid projects={secondaryProjects} />
                </div>
              </details>
            )
          }

          {
            projects.length > 0 && secondaryProjects.length === 0 && (
              <TerminalEmptyState
                class="mt-12"
                messageId="projects.secondaryEmpty"
              />
            )
          }
        </>
      )
    }
  </div>
</MainLayout>

<script>
  const details = document.querySelector("details.soc-details") as HTMLDetailsElement | null;
  const label = document.querySelector("[data-details-label]") as HTMLElement | null;

  if (details && label) {
    const openLabel = label.dataset.open ?? "";
    const closedLabel = label.dataset.closed ?? "";
    details.addEventListener("toggle", () => {
      label.textContent = details.open ? openLabel : closedLabel;
    });
  }

  // B2: filter kategori — sembunyikan kartu yang bukan kategori terpilih.
  const cards = Array.from(document.querySelectorAll("article[data-category]")) as HTMLElement[];
  const empty = document.getElementById("filter-empty") as HTMLElement | null;
  const chips = Array.from(document.querySelectorAll("[data-filter], [data-filter-all]")) as HTMLButtonElement[];

  const ACTIVE_CLASSES = ["border-cyber-primary/60", "bg-cyber-primary/10", "text-cyber-primary"];
  const INACTIVE_CLASSES = ["border-cyber-border", "text-cyber-muted"];

  function setActive(chip: HTMLButtonElement, on: boolean): void {
    chip.setAttribute("aria-pressed", String(on));
    for (const cls of ACTIVE_CLASSES) chip.classList.toggle(cls, on);
    for (const cls of INACTIVE_CLASSES) chip.classList.toggle(cls, !on);
  }

  function applyFilter(category: string | null): void {
    let visible = 0;
    let secondaryVisible = 0;
    for (const card of cards) {
      const shown = category === null || (card.dataset.category ?? "") === category;
      card.hidden = !shown;
      if (shown) {
        visible += 1;
        if (details && details.contains(card)) secondaryVisible += 1;
      }
    }
    if (empty) empty.hidden = visible > 0;
    // Kalau hasil filter adanya di dalam section "secondary" yang terlipat,
    // buka otomatis — kalau tidak, pengguna melihat grid kosong tanpa penjelasan
    // (empty state tidak muncul karena visible > 0).
    if (details && category !== null && secondaryVisible > 0) details.open = true;
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const isAll = chip.dataset.filterAll !== undefined;
      const selected = isAll ? null : (chip.dataset.filter ?? null);
      for (const other of chips) {
        setActive(other, other === chip && !isAll);
      }
      if (isAll) setActive(chip, true);
      applyFilter(selected);
    });
  }
</script>
