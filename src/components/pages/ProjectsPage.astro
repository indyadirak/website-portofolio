---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import ProjectGrid from "../ProjectGrid.astro";
import TerminalEmptyState from "../ui/TerminalEmptyState.astro";
import { getProjects, getProjectCategories } from "../../lib/data/projects";
import { getDictionary, localeFromUrl } from "../../lib/i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

const projects = await getProjects();
// Kategori aktif utk filter charter (B2: dinamis dari project_categories).
const categories = await getProjectCategories();

// B1 batch-4: hitung project per nama kategori tampilan (multi-kategori:
// satu project terhitung di tiap kategorinya), lalu sembunyikan opsi yang
// count-nya 0 agar kategori baru yang belum dipakai tidak memenuhi filter.
const countByCategory = new Map<string, number>();
for (const p of projects) {
  const names = p.categories.length > 0 ? p.categories : [p.category];
  for (const name of names) {
    if (!name) continue;
    countByCategory.set(name, (countByCategory.get(name) ?? 0) + 1);
  }
}
const visibleCategories = categories
  .map((c) => ({ ...c, count: countByCategory.get(c.name) ?? 0 }))
  .filter((c) => c.count > 0);

// Featured vs secondary: kolom `featured` (boolean) pada tabel projects.
const featuredProjects = projects.filter((p) => p.featured);
const secondaryProjects = projects.filter((p) => !p.featured);
---

<MainLayout title={t.projects.title} description={t.meta.projects}>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      eyebrow={t.projects.eyebrow}
      title={t.projects.title}
      description={t.projects.description}
    />

    {
      projects.length === 0 ? (
        <TerminalEmptyState
          class="mt-12"
          command="ls"
          directory="/projects"
          messageId="projects.noProjects"
        />
      ) : (
        <>
          <!-- B1 batch-4: filter command-prompt + multi-kategori (client-side, tanpa reload) -->
          <div class="mt-8" id="tag-filter">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-xs uppercase tracking-wider text-cyber-muted">
                {t.projects.filterPrompt}
              </span>
              <div class="relative min-w-52 flex-1">
                <input
                  id="filter-input"
                  type="text"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="filter-listbox"
                  aria-autocomplete="list"
                  autocomplete="off"
                  placeholder={t.projects.filterPlaceholder}
                  class="w-full rounded border border-cyber-border bg-cyber-panel px-3 py-2 font-mono text-xs text-slate-200 outline-none focus:border-cyber-primary"
                />
                <div
                  id="filter-listbox"
                  role="listbox"
                  hidden
                  class="absolute left-0 right-0 top-full z-30 mt-1 max-h-64 overflow-y-auto rounded border border-cyber-border bg-cyber-panel shadow-2xl max-md:fixed max-md:inset-x-4 max-md:bottom-4 max-md:top-auto max-md:max-h-[50vh]"
                >
                  {visibleCategories.map((c, i) => (
                    <button
                      type="button"
                      id={`filter-opt-${i}`}
                      role="option"
                      data-filter-option={c.name}
                      class="flex w-full items-center justify-between gap-2 px-3 py-2 text-left font-mono text-xs text-slate-200 hover:bg-cyber-card hover:text-cyber-primary"
                    >
                      <span>{c.name}</span>
                      <span class="text-cyber-muted/70">({c.count})</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
            <div
              id="filter-tags"
              hidden
              data-i18n-remove={t.projects.filterRemove}
              class="mt-3 flex flex-wrap items-center gap-2"
            >
              <div id="filter-chips" class="flex flex-wrap items-center gap-2"></div>
              <button
                id="filter-clear"
                type="button"
                class="rounded border border-cyber-border px-3 py-1 font-mono text-xs text-cyber-muted hover:border-cyber-primary hover:text-cyber-primary"
              >
                {t.projects.filterClear}
              </button>
            </div>
            <p id="filter-nomatch" hidden class="mt-2 font-mono text-xs text-cyber-muted">
              {t.projects.filterNoMatch}
            </p>
          </div>

          <TerminalEmptyState
            id="filter-empty"
            class="mt-12"
            hidden
            messageId="projects.categoryEmpty"
          />

          <ProjectGrid projects={featuredProjects} />

          {
            secondaryProjects.length > 0 && (
              <details class="soc-details mt-16 rounded border border-cyber-border bg-cyber-card p-6">
                <summary class="flex min-h-11 flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-lg font-bold text-white">
                    {t.projects.secondaryTitle}
                  </span>
                  <span class="font-mono text-xs text-cyber-accent">
                    <span data-details-label data-open={t.projects.collapseSecondary} data-closed={t.projects.expandSecondary}>
                      {t.projects.expandSecondary}
                    </span>
                    <span class="font-mono text-xs text-cyber-muted">
                      ({secondaryProjects.length})
                    </span>
                  </span>
                </summary>

                <div class="soc-details-content mt-6">
                  <p class="mb-6 text-sm leading-relaxed text-cyber-muted">
                    {t.projects.secondaryDescription}
                  </p>
                  <ProjectGrid projects={secondaryProjects} />
                </div>
              </details>
            )
          }

          {
            projects.length > 0 && secondaryProjects.length === 0 && (
              <TerminalEmptyState
                class="mt-12"
                messageId="projects.secondaryEmpty"
              />
            )
          }
        </>
      )
    }
  </div>
</MainLayout>

<script>
  const details = document.querySelector("details.soc-details") as HTMLDetailsElement | null;
  const label = document.querySelector("[data-details-label]") as HTMLElement | null;

  if (details && label) {
    const openLabel = label.dataset.open ?? "";
    const closedLabel = label.dataset.closed ?? "";
    details.addEventListener("toggle", () => {
      label.textContent = details.open ? openLabel : closedLabel;
    });
  }

  // B1 batch-4: filter command-prompt — ketik -> autocomplete (nama + count,
  // navigable via keyboard), pilih -> chip, filter client-side logika OR.
  const cards = Array.from(document.querySelectorAll("article[data-category]")) as HTMLElement[];
  const empty = document.getElementById("filter-empty") as HTMLElement | null;
  const filterInput = document.getElementById("filter-input") as HTMLInputElement | null;
  const filterListbox = document.getElementById("filter-listbox") as HTMLElement | null;
  const filterTags = document.getElementById("filter-tags") as HTMLElement | null;
  const filterChips = document.getElementById("filter-chips") as HTMLElement | null;
  const filterClear = document.getElementById("filter-clear") as HTMLButtonElement | null;
  const filterNoMatch = document.getElementById("filter-nomatch") as HTMLElement | null;
  const removeTpl = filterTags?.dataset.i18nRemove ?? 'Remove "{tag}"';

  const filterOptions = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-option]")
  );
  const selectedTags = new Set<string>();
  let activeOption = -1;

  function visibleOptions(): HTMLButtonElement[] {
    return filterOptions.filter((o) => !o.hidden);
  }

  function paintActive(): void {
    const vis = visibleOptions();
    vis.forEach((o, i) => {
      const on = i === activeOption;
      o.classList.toggle("bg-cyber-card", on);
      o.classList.toggle("text-cyber-primary", on);
      if (on && o.id) filterInput?.setAttribute("aria-activedescendant", o.id);
    });
    if (activeOption < 0) filterInput?.removeAttribute("aria-activedescendant");
  }

  function renderDropdown(): void {
    if (!filterInput || !filterListbox) return;
    const q = filterInput.value.trim().toLowerCase();
    let any = false;
    for (const o of filterOptions) {
      const name = o.dataset.filterOption ?? "";
      const match = name.toLowerCase().includes(q) && !selectedTags.has(name);
      o.hidden = !match;
      if (match) any = true;
    }
    activeOption = -1;
    paintActive();
    filterListbox.hidden = !any;
    filterInput.setAttribute("aria-expanded", String(any));
    if (filterNoMatch) filterNoMatch.hidden = any || q === "";
  }

  function renderChips(): void {
    if (!filterChips || !filterTags) return;
    filterChips.textContent = "";
    for (const tag of selectedTags) {
      const chip = document.createElement("span");
      chip.className =
        "inline-flex items-center gap-1 rounded border border-cyber-primary/60 bg-cyber-primary/10 px-2 py-1 font-mono text-xs text-cyber-primary";
      const nameEl = document.createElement("span");
      nameEl.textContent = tag;
      const x = document.createElement("button");
      x.type = "button";
      x.textContent = "×";
      x.setAttribute("aria-label", removeTpl.replace("{tag}", tag));
      x.className = "rounded px-1 hover:bg-cyber-primary hover:text-cyber-bg";
      x.addEventListener("click", () => {
        selectedTags.delete(tag);
        renderChips();
        renderDropdown();
        applyFilter();
      });
      chip.append(nameEl, x);
      filterChips.appendChild(chip);
    }
    filterTags.hidden = selectedTags.size === 0;
  }

  function applyFilter(): void {
    let visible = 0;
    let secondaryVisible = 0;
    for (const card of cards) {
      const cats = (card.dataset.categories ?? "").split("|");
      const shown =
        selectedTags.size === 0 || [...selectedTags].some((tag) => cats.includes(tag));
      card.hidden = !shown;
      if (shown) {
        visible += 1;
        if (details && details.contains(card)) secondaryVisible += 1;
      }
    }
    if (empty) empty.hidden = visible > 0;
    // Kalau hasil filter adanya di dalam section "secondary" yang terlipat,
    // buka otomatis — kalau tidak, pengguna melihat grid kosong tanpa penjelasan
    // (empty state tidak muncul karena visible > 0).
    if (details && selectedTags.size > 0 && secondaryVisible > 0) details.open = true;
  }

  function pickTag(name: string): void {
    if (!name || selectedTags.has(name)) return;
    selectedTags.add(name);
    if (filterInput) filterInput.value = "";
    renderChips();
    renderDropdown();
    applyFilter();
    filterInput?.focus();
  }

  filterInput?.addEventListener("input", renderDropdown);
  filterInput?.addEventListener("focus", renderDropdown);
  filterInput?.addEventListener("keydown", (event) => {
    const vis = visibleOptions();
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      if (vis.length === 0) return;
      event.preventDefault();
      activeOption =
        event.key === "ArrowDown"
          ? (activeOption + 1) % vis.length
          : (activeOption - 1 + vis.length) % vis.length;
      paintActive();
      vis[activeOption]?.scrollIntoView({ block: "nearest" });
    } else if (event.key === "Enter") {
      const target = vis[activeOption] ?? vis[0];
      const name = target?.dataset.filterOption ?? "";
      if (name) {
        event.preventDefault();
        pickTag(name);
      }
    } else if (event.key === "Escape") {
      if (filterListbox && !filterListbox.hidden && filterInput) {
        event.preventDefault();
        filterListbox.hidden = true;
        filterInput.setAttribute("aria-expanded", "false");
      }
    }
  });

  for (const o of filterOptions) {
    o.addEventListener("click", () => pickTag(o.dataset.filterOption ?? ""));
  }

  filterClear?.addEventListener("click", () => {
    selectedTags.clear();
    renderChips();
    renderDropdown();
    applyFilter();
    filterInput?.focus();
  });

  document.addEventListener("click", (event) => {
    if (
      filterListbox &&
      !filterListbox.hidden &&
      filterInput &&
      event.target instanceof Node &&
      !filterListbox.contains(event.target) &&
      event.target !== filterInput
    ) {
      filterListbox.hidden = true;
      filterInput.setAttribute("aria-expanded", "false");
    }
  });
</script>
