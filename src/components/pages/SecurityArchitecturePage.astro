---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);

/** Warna monospace untuk diagram ASCII: box & panah di-accent, label polos. */
function renderDiagramLine(line: string): string {
  const box = line.match(/^(\s*)(\[)([^\]]*)(\])(.*)$/);
  if (!box) {
    if (/^\s*[|v]+$/.test(line)) return `<span class="text-cyber-accent">${line}</span>`;
    return `<span class="text-cyber-muted">${line}</span>`;
  }
  const [, indent, open, label, close, rest] = box;
  return `${indent}<span class="text-cyber-primary">${open}</span><span class="text-slate-200">${label}</span><span class="text-cyber-primary">${close}</span><span class="text-cyber-muted">${rest}</span>`;
}

const scopeCards = [
  { title: t.securityArch.scopeTitle, items: t.securityArch.scope },
  { title: t.securityArch.outOfScopeTitle, items: t.securityArch.outOfScope },
  { title: t.securityArch.safeHarborTitle, items: t.securityArch.safeHarbor },
];
---

<MainLayout title={t.securityArch.title} description={t.securityArch.description}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <SectionHeading
      eyebrow={t.securityArch.eyebrow}
      title={t.securityArch.title}
      description={t.securityArch.lastUpdated}
    />

    <div class="mt-8 space-y-6">
      <!-- Diagram defense-in-depth -->
      <section class="rounded border border-cyber-border bg-cyber-card p-6 md:p-8">
        <p class="font-mono text-sm text-cyber-accent">{t.securityArch.diagramTitle}</p>
        <pre class="mt-4 overflow-x-auto font-mono text-[13px] leading-6 text-slate-300" set:html={t.securityArch.diagram.map(renderDiagramLine).join("\n")}></pre>
      </section>

      <!-- Live security posture -->
      <section class="rounded border border-cyber-border bg-cyber-card p-6 md:p-8">
        <p class="font-mono text-sm text-cyber-accent">{t.securityArch.postureTitle}</p>
        <ul class="mt-4 space-y-2 font-mono text-sm">
          {
            t.securityArch.posture.map((line) => {
              const match = line.match(/^(\[.\]) (.*)$/);
              return (
                <li class="flex gap-2">
                  <span class="text-emerald-400">{match?.[1] ?? ""}</span>
                  <span class="text-slate-300">{match?.[2] ?? line}</span>
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- Responsible disclosure -->
      <section class="rounded border border-cyber-border bg-cyber-card p-6 md:p-8">
        <p class="font-mono text-sm text-cyber-accent">{t.securityArch.disclosureTitle}</p>
        <p class="mt-3 font-mono text-sm leading-relaxed text-cyber-muted">
          {t.securityArch.disclosureIntro}
        </p>
        <div class="mt-6 space-y-6">
          {
            scopeCards.map((card) => (
              <div>
                <p class="font-mono text-xs uppercase tracking-wider text-cyber-primary">
                  $ {card.title}
                </p>
                <ul class="mt-2 space-y-1.5 font-mono text-sm text-slate-300">
                  {card.items.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-cyber-accent">-</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</MainLayout>