---
import MainLayout from "../../layouts/MainLayout.astro";
import CaseStudyContent from "../CaseStudyContent.astro";
import { getDictionary, localeFromUrl } from "../../lib/i18n";
import type { Writeup } from "../../lib/types";

interface Props {
  writeup: Writeup;
}

const { writeup } = Astro.props;

const locale = localeFromUrl(Astro.url);
const t = getDictionary(locale);
const d = t.writeups.detail;
const cs = t.writeups.caseStudy;

const severityStyle: Record<Writeup["severity"], string> = {
  Critical: "border-cyber-danger/60 text-cyber-danger",
  High: "border-amber-500/60 text-amber-400",
  Med: "border-yellow-500/50 text-yellow-300",
  Low: "border-cyber-muted/50 text-cyber-muted",
};

type ContentBlock = { type: "paragraph"; text: string } | { type: "code"; text: string };
type CaseSection = { title: string | null; blocks: ContentBlock[] };

/**
 * SP4A.3: header kanonik case study. Konten write-up boleh disisipi
 * penanda bagian ("Overview:", "## Attack Path", "Detection:" dll) —
 * parser memecahnya menjadi blok terstruktur dengan label terjemahan.
 */
const headerPattern =
  /^\s*(?:#{1,3}\s*)?(?:\[+\s*)?(overview|methodology|attack\s*path|detection|mitigation|lessons\s*learned)\s*(?:\]+\s*)?[:\s]*$/i;

const caseStudyLabels: Record<string, string> = {
  overview: cs.overview,
  methodology: cs.methodology,
  "attack path": cs.attackPath,
  detection: cs.detection,
  mitigation: cs.mitigation,
  "lessons learned": cs.lessonsLearned,
};

function normalizeHeader(raw: string): string {
  return raw.toLowerCase().replace(/\s+/g, " ").trim();
}

function parseCaseStudy(raw: string): CaseSection[] {
  const lines = raw.replace(/\r\n/g, "\n").split("\n");
  const sections: CaseSection[] = [];
  let current: CaseSection = { title: null, blocks: [] };
  let paragraph: string[] = [];
  let code: string[] | null = null;

  const pushParagraph = () => {
    const text = paragraph.join("\n").trim();
    if (text) current.blocks.push({ type: "paragraph", text });
    paragraph = [];
  };

  for (const line of lines) {
    if (line.trim().startsWith("```")) {
      pushParagraph();
      if (code === null) {
        code = [];
      } else {
        current.blocks.push({ type: "code", text: code.join("\n").trim() });
        code = null;
      }
      continue;
    }
    if (code !== null) {
      code.push(line);
      continue;
    }
    const header = line.match(headerPattern);
    if (header) {
      pushParagraph();
      if (current.title !== null || current.blocks.length > 0) sections.push(current);
      current = { title: caseStudyLabels[normalizeHeader(header[1])] ?? null, blocks: [] };
      continue;
    }
    if (line.trim() === "") {
      pushParagraph();
      continue;
    }
    paragraph.push(line);
  }
  pushParagraph();
  if (code !== null && code.join("\n").trim()) {
    current.blocks.push({ type: "code", text: code.join("\n").trim() });
  }
  if (current.title !== null || current.blocks.length > 0) sections.push(current);
  return sections;
}

/**
 * Render terstruktur hanya bila konten benar-benar memakai header kanonik;
 * kalau tidak, fallback ke satu blok kode utuh (perilaku lama).
 */
function structuredSections(raw: string): CaseSection[] | null {
  const sections = parseCaseStudy(raw);
  const hasHeaders = sections.some((section) => section.title !== null);
  return hasHeaders ? sections : null;
}

const findingsSections = structuredSections(writeup.findings);
const remediationSections = structuredSections(writeup.remediation);

const backHref = locale === "en" ? "/en/writeups" : "/writeups";
const fmt = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "id-ID", {
  dateStyle: "long",
});
---

<MainLayout title={`${writeup.title} — Write-up`} description={writeup.findings.slice(0, 160)}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <a
      href={backHref}
      class="font-mono text-xs text-cyber-muted transition-colors hover:text-cyber-primary"
    >
      {d.back}
    </a>

    <h1 class="mt-6 font-mono text-3xl font-bold text-white">
      {writeup.title}<span class="text-cyber-primary">;</span>
    </h1>

    <div class="mt-4 flex flex-wrap gap-2 font-mono text-[11px] uppercase tracking-wider">
      <span class="rounded border border-cyber-primary/50 px-2 py-0.5 text-cyber-primary">
        {writeup.targetEnv}
      </span>
      <span class={`rounded border px-2 py-0.5 ${severityStyle[writeup.severity]}`}>
        {writeup.severity}
      </span>
      <span class="rounded border border-cyber-border px-2 py-0.5 text-cyber-muted">
        {writeup.methodology}
      </span>
    </div>

    <p class="mt-4 font-mono text-[11px] text-cyber-muted">
      {d.updated}: {fmt.format(new Date(writeup.updatedAt))}
    </p>

    <div class="mt-10 space-y-8">
      <section class="case-study-section">
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {d.target}
        </h2>
        <p class="mt-2 font-mono text-sm text-slate-200">{writeup.targetEnv}</p>
      </section>

      <section class="case-study-section">
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {d.methodology}
        </h2>
        <p class="mt-2 font-mono text-sm text-slate-200">{writeup.methodology}</p>
      </section>

      <section>
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {d.findings}
        </h2>
        {
          findingsSections ? (
            <div class="mt-3">
              <CaseStudyContent sections={findingsSections} />
            </div>
          ) : (
            <pre class="writeup-code-block mt-2"><code>{writeup.findings}</code></pre>
          )
        }
      </section>

      <section>
        <h2 class="font-mono text-sm font-bold uppercase tracking-wider text-cyber-accent">
          {d.remediation}
        </h2>
        {
          remediationSections ? (
            <div class="mt-3">
              <CaseStudyContent sections={remediationSections} />
            </div>
          ) : (
            <pre class="writeup-code-block mt-2"><code>{writeup.remediation}</code></pre>
          )
        }
      </section>
    </div>
  </div>
</MainLayout>
