---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { canDeleteCertificates } from "../../lib/auth";

export const prerender = false;

// Middleware sudah memvalidasi sesi; guard ulang defensif (pola dashboard).
const { user, profile, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/admin/login");
}

const isAdmin = canDeleteCertificates(profile); // admin saja

// Guard defensif: middleware sudah memblokir non-admin (403), tapi bila
// ada jalur bypass, halaman ini menolak dirender dan menampilkan 403.
if (!isAdmin) {
  return Astro.rewrite("/403");
}

// SELECT di-guard RLS: non-admin tidak akan mendapat baris ini.
let config: {
  clientEmail: string | null;
  folderTail: string | null;
  updatedAt: string | null;
  updatedBy: string | null;
} | null = null;

if (isAdmin) {
  const { data } = await supabase
    .from("backup_config")
    .select("*")
    .eq("id", 1)
    .maybeSingle();

  if (data?.gdrive_service_account_key) {
    let clientEmail: string | null = null;
    try {
      const raw =
        data.gdrive_service_account_key.startsWith("enc:")
          ? null // ciphertext — hanya tail email yang bisa disimpulkan; jangan tampilkan
          : (JSON.parse(data.gdrive_service_account_key) as { client_email?: string });
      clientEmail = raw?.client_email ?? null;
    } catch {
      clientEmail = null;
    }
    config = {
      clientEmail,
      folderTail: data.gdrive_folder_id
        ? data.gdrive_folder_id.slice(-6)
        : null,
      updatedAt: data.updated_at,
      updatedBy: data.updated_by,
    };
  }
}
---

<AdminLayout
  title="Google Drive Backup"
  description="Admin — konfigurasi offload backup mingguan (prinsip 3-2-1) ke Google Drive."
  current="backup"
>
  <div class="mx-auto max-w-3xl py-8 md:py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="font-mono text-sm text-cyber-accent">$ backup --config</p>
        <h1 class="mt-2 font-mono text-3xl font-bold text-white">
          Google Drive<span class="text-cyber-primary">;</span>
        </h1>
      </div>
      <a
        href="/admin/dashboard"
        class="rounded border border-cyber-border px-4 py-2 font-mono text-xs text-slate-300 transition-colors hover:border-cyber-primary hover:text-cyber-primary"
      >
        &lt;- dashboard
      </a>
    </div>

    {
      isAdmin && (
        <>
          <!-- ===== STATUS SAAT INI ===== -->
          <section class="mt-10 rounded border border-cyber-border bg-cyber-panel p-6">
            <h2 class="font-mono text-lg font-bold text-white">Status</h2>
            {
              config ? (
                <dl class="mt-4 space-y-2 font-mono text-xs text-slate-300">
                  <div class="flex justify-between gap-4">
                    <dt class="text-cyber-muted">service account</dt>
                    <dd class="text-right">
                      {config.clientEmail
                        ? config.clientEmail.replace(/^(.{4}).*(@.*)$/, "$1***$2")
                        : "tersimpan (terenkripsi, tidak ditampilkan)"}
                    </dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-cyber-muted">folder drive (id)</dt>
                    <dd class="text-right">…{config.folderTail ?? "-"}</dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-cyber-muted">updated</dt>
                    <dd class="text-right">
                      {config.updatedAt ? new Date(config.updatedAt).toLocaleString("id-ID") : "-"}
                      {config.updatedBy ? ` oleh ${config.updatedBy}` : ""}
                    </dd>
                  </div>
                </dl>
              ) : (
                <p class="mt-4 font-mono text-xs text-cyber-muted">
                  $ echo "belum dikonfigurasi — backup mingguan hanya tersimpan sebagai artifact GitHub."
                </p>
              )
            }
          </section>

          <!-- ===== FORM KONFIGURASI ===== -->
          <section class="mt-6 rounded border border-cyber-border bg-cyber-panel p-6 md:p-8">
            <h2 class="font-mono text-lg font-bold text-white">Konfigurasi Service Account</h2>
            <p class="mt-2 font-mono text-xs leading-relaxed text-cyber-muted">
              Paste isi JSON key Service Account (download dari Google Cloud Console,
              halaman Keys) dan ID folder Drive tujuan. Key disimpan terenkripsi
              (AES-256-GCM) sebelum masuk database dan tidak pernah ditampilkan kembali.
            </p>

            <form id="backup-config-form" class="mt-6 space-y-5">
              <div>
                <label for="sa-key" class="font-mono text-xs text-slate-300">
                  JSON Service Account key
                </label>
                <textarea
                  id="sa-key"
                  name="saKey"
                  rows="7"
                  spellcheck="false"
                  placeholder='{ "type": "...", "project_id": "...", "client_email": "...", "private_key": "<PASTE KEY HERE>" }'
                  class="mt-2 w-full resize-y rounded border border-cyber-border bg-cyber-card p-3 font-mono text-xs text-slate-200 placeholder:text-cyber-muted focus:border-cyber-primary focus:outline-none"
                ></textarea>
                <p class="mt-1 font-mono text-[11px] text-cyber-muted">
                  kosongkan bila hanya ingin mengubah folder ID.
                </p>
              </div>

              <div>
                <label for="folder-id" class="font-mono text-xs text-slate-300">
                  Google Drive folder ID
                </label>
                <input
                  id="folder-id"
                  name="folderId"
                  type="text"
                  placeholder="https://drive.google.com/drive/folders/XXXXX → isi XXXXX"
                  class="mt-2 w-full rounded border border-cyber-border bg-cyber-card p-3 font-mono text-xs text-slate-200 placeholder:text-cyber-muted focus:border-cyber-primary focus:outline-none"
                />
              </div>

              <p id="form-status" class="hidden font-mono text-xs" role="status"></p>

              <div class="flex flex-wrap items-center gap-4">
                <button
                  type="submit"
                  class="rounded border border-cyber-primary bg-cyber-primary/10 px-6 py-2.5 font-mono text-xs text-cyber-primary transition-colors hover:bg-cyber-primary/20 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  [ simpan konfigurasi ]
                </button>

                {
                  config && (
                    <button
                      id="unlink-btn"
                      type="button"
                      class="rounded border border-cyber-danger px-6 py-2.5 font-mono text-xs text-cyber-danger transition-colors hover:bg-cyber-danger/10 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      [ putuskan koneksi ]
                    </button>
                  )
                }
              </div>
            </form>
          </section>
        </>
      )
    }
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("backup-config-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLParagraphElement;
  const saKey = document.getElementById("sa-key") as HTMLTextAreaElement;
  const folderId = document.getElementById("folder-id") as HTMLInputElement;
  const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement;
  const unlinkBtn = document.getElementById("unlink-btn") as HTMLButtonElement | null;

  function setStatus(text: string, ok: boolean) {
    statusEl.textContent = `$ ${text}`;
    statusEl.classList.toggle("hidden", false);
    statusEl.classList.toggle("text-cyber-accent", ok);
    statusEl.classList.toggle("text-cyber-danger", !ok);
  }

  async function call(method: "POST" | "DELETE", body?: unknown) {
    const res = await fetch("/api/admin/backup-config", {
      method,
      headers: body ? { "Content-Type": "application/json" } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    return { res, data: await res.json().catch(() => ({})) };
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const key = saKey.value.trim();
    const folder = folderId.value.trim();
    if (!key && !folder) {
      setStatus("isi minimal salah satu field (JSON key atau folder ID).", false);
      return;
    }
    submitBtn.disabled = true;
    const { res, data } = await call("POST", {
      gdriveServiceAccountKey: key || undefined,
      gdriveFolderId: folder || undefined,
    });
    submitBtn.disabled = false;
    if (res.ok && (data as { ok?: boolean }).ok) {
      setStatus("konfigurasi tersimpan — backup mingguan berikutnya akan mengunggah ke Drive.", true);
      setTimeout(() => window.location.reload(), 900);
    } else {
      const msg = (data as { error?: string }).error ?? "gagal menyimpan";
      setStatus(`gagal: ${msg}`, false);
    }
  });

  unlinkBtn?.addEventListener("click", async () => {
    if (!window.confirm("Putuskan koneksi Google Drive? Backup mingguan hanya akan tersimpan sebagai artifact GitHub.")) {
      return;
    }
    unlinkBtn.disabled = true;
    const { res, data } = await call("DELETE");
    unlinkBtn.disabled = false;
    if (res.ok && (data as { ok?: boolean }).ok) {
      setStatus("koneksi diputus — konfigurasi dihapus.", true);
      setTimeout(() => window.location.reload(), 900);
    } else {
      setStatus("gagal memutuskan koneksi.", false);
    }
  });
</script>
