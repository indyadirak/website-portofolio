---
import AdminLayout from "../../layouts/AdminLayout.astro";
import TerminalButton from "../../components/admin/ui/TerminalButton.astro";
import TerminalInput from "../../components/admin/ui/TerminalInput.astro";
import TerminalTable from "../../components/admin/ui/TerminalTable.astro";
import { canManageSiteContent } from "../../lib/auth";
import { getDictionary, localeFromPathname } from "../../lib/i18n";
import { SITE_SETTING_KEYS, type SiteSettingRow } from "../../lib/types";

export const prerender = false;

const { user, profile, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/admin/login");
}

if (!canManageSiteContent(profile)) {
  return Astro.redirect("/403");
}

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const { data: rawSettings } = await supabase
  .from("site_settings")
  .select("id, key, value, created_at, updated_at")
  .order("key", { ascending: true });

const settings = (rawSettings ?? []) as SiteSettingRow[];
const byKey = new Map(settings.map((s) => [s.key, s.value]));
---

<AdminLayout title="Site Settings — Admin" description={t.adminSettings.description} current="settings">
  <div class="mx-auto max-w-4xl py-8 md:py-10">
    <div>
      <p class="font-mono text-sm text-cyber-accent">{t.adminSettings.eyebrow}</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white">
        {t.adminSettings.title}<span class="text-cyber-primary">;</span>
      </h1>
      <p class="mt-2 max-w-xl font-mono text-xs leading-relaxed text-cyber-muted">
        {t.adminSettings.description}
      </p>
    </div>

    <form
      id="settings-form"
      data-i18n-saved={t.adminSettings.saved}
      data-i18n-error-prefix={t.adminSettings.errorPrefix}
      data-i18n-errors={JSON.stringify(t.errors)}
      class="mt-8 space-y-5 rounded border border-cyber-border bg-cyber-panel p-6"
    >
      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">hero_title *</span>
        <TerminalInput id="s-hero-title" type="text" maxlength={120} value={byKey.get("hero_title") ?? ""} />
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">hero_tagline *</span>
        <TerminalInput id="s-hero-tagline" type="text" maxlength={120} value={byKey.get("hero_tagline") ?? ""} />
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">short_bio *</span>
        <textarea id="s-short-bio" rows={4} maxlength={500}
          class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">{byKey.get("short_bio") ?? ""}</textarea>
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">{t.adminSettings.aboutBio}</span>
        <textarea id="s-about-bio" rows={4} maxlength={1000}
          placeholder={t.adminSettings.contactInfoPlaceholder}
          class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">{byKey.get("about_bio") ?? ""}</textarea>
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">{t.adminSettings.specializations}</span>
        <textarea id="s-about-specializations" rows={5} maxlength={1000}
          placeholder={t.adminSettings.specializationsPlaceholder}
          class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">{(() => { try { return (JSON.parse(byKey.get("about_specializations") ?? "[]") as string[]).join("\n"); } catch { return ""; } })()}</textarea>
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">{t.adminSettings.contactInfo}</span>
        <textarea id="s-about-contact-info" rows={3} maxlength={500}
          placeholder={t.adminSettings.contactInfoPlaceholder}
          class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">{byKey.get("about_contact_info") ?? ""}</textarea>
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">availability_status *</span>
        <select id="s-availability"
          class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">
          <option value="open-to-work" selected={byKey.get("availability_status") === "open-to-work"}>
            {t.adminSettings.availabilityOpen}
          </option>
          <option value="not-available" selected={byKey.get("availability_status") === "not-available"}>
            {t.adminSettings.availabilityClosed}
          </option>
        </select>
      </label>

      <div class="flex items-center gap-4">
        <TerminalButton type="submit" id="s-submit">
          {t.adminSettings.save}
        </TerminalButton>
        <p id="s-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-danger"></p>
      </div>
    </form>

    <section class="mt-10">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-mono text-lg font-bold text-white">{t.adminSettings.keyColumn}</h2>
        <span class="font-mono text-xs text-cyber-muted">{t.adminSettings.valueColumn}</span>
      </div>
      <TerminalTable
        columns={[
          { key: "#", label: "#" },
          { key: "key", label: "key" },
          { key: "value", label: "value" },
        ]}
      >
        {SITE_SETTING_KEYS.map((key, i) => (
          <tr class="border-b border-cyber-border/40">
            <td class="px-4 py-3 text-cyber-muted">{String(i + 1).padStart(2, "0")}</td>
            <td class="px-4 py-3 text-cyber-accent">{key}</td>
            <td class="px-4 py-3 text-slate-200">{byKey.get(key) ?? ""}</td>
          </tr>
        ))}
      </TerminalTable>
    </section>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("settings-form") as HTMLFormElement;
  const savedMsg = form.dataset.i18nSaved ?? "";
  const errorPrefix = form.dataset.i18nErrorPrefix ?? "";
  let errorTexts: Record<string, string> = {};
  try {
    errorTexts = JSON.parse(form.dataset.i18nErrors ?? "{}") as Record<string, string>;
  } catch {
    errorTexts = {};
  }
  const errText = (code: string): string => errorTexts[code] ?? code;
  const submitBtn = document.getElementById("s-submit") as HTMLButtonElement;
  const statusEl = document.getElementById("s-status") as HTMLParagraphElement;

  const fields: Array<{ key: string; input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement }> = [
    { key: "hero_title", input: document.getElementById("s-hero-title") as HTMLInputElement },
    { key: "hero_tagline", input: document.getElementById("s-hero-tagline") as HTMLInputElement },
    { key: "short_bio", input: document.getElementById("s-short-bio") as HTMLTextAreaElement },
    { key: "about_bio", input: document.getElementById("s-about-bio") as HTMLTextAreaElement },
    { key: "about_specializations", input: document.getElementById("s-about-specializations") as HTMLTextAreaElement },
    { key: "about_contact_info", input: document.getElementById("s-about-contact-info") as HTMLTextAreaElement },
    { key: "availability_status", input: document.getElementById("s-availability") as HTMLSelectElement },
  ];

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    statusEl.textContent = "";
    submitBtn.disabled = true;

    for (const field of fields) {
      const res = await fetch(
        `/api/admin/site-settings?key=${encodeURIComponent(field.key)}`,
        {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            value: field.key === "about_specializations"
              ? JSON.stringify(field.input.value.split("\n").map((item) => item.trim()).filter(Boolean))
              : field.input.value.trim(),
          }),
        }
      ).catch(() => null);

      if (!res || !res.ok) {
        const data = res ? await res.json().catch(() => ({ error: "unknown" })) : { error: "network" };
        statusEl.textContent = `${errorPrefix} ${errText(data.error ?? "unknown")} — key ${field.key}`;
        submitBtn.disabled = false;
        return;
      }
    }

    submitBtn.disabled = false;
    statusEl.textContent = savedMsg;
  });
</script>
