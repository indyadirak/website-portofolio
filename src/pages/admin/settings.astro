---
import MainLayout from "../../layouts/MainLayout.astro";
import { canManageSiteContent } from "../../lib/auth";
import { getDictionary, localeFromPathname } from "../../lib/i18n";
import { SITE_SETTING_KEYS, type SiteSettingRow } from "../../lib/types";

export const prerender = false;

const { user, profile, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/admin/login");
}

if (!canManageSiteContent(profile)) {
  return Astro.redirect("/403");
}

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const { data: rawSettings } = await supabase
  .from("site_settings")
  .select("id, key, value, created_at, updated_at")
  .order("key", { ascending: true });

const settings = (rawSettings ?? []) as SiteSettingRow[];
const byKey = new Map(settings.map((s) => [s.key, s.value]));
const role = profile?.role ?? "viewer";

const quickActions = [
  { label: "[ dashboard ]", href: "/admin/dashboard" },
  { label: "[ experiences ]", href: "/admin/experiences" },
  { label: "[ social links ]", href: "/admin/social-links" },
  { label: "[ writeups ]", href: "/admin/writeups" },
  { label: "[ cv ]", href: "/admin/cv" },
  { label: "[ backup ]", href: "/admin/backup" },
];
---

<MainLayout title="Site Settings — Admin" description={t.adminSettings.description}>
  <div class="mx-auto max-w-4xl px-6 py-14">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="font-mono text-sm text-cyber-accent">{t.adminSettings.eyebrow}</p>
        <h1 class="mt-2 font-mono text-3xl font-bold text-white">
          {t.adminSettings.title}<span class="text-cyber-primary">;</span>
        </h1>
        <p class="mt-2 max-w-xl font-mono text-xs leading-relaxed text-cyber-muted">
          {t.adminSettings.description}
        </p>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="/admin/dashboard"
          class="rounded border border-cyber-border px-4 py-2 font-mono text-xs text-slate-300 transition-colors hover:border-cyber-accent hover:text-cyber-accent"
        >
          {t.adminSettings.back}
        </a>
        <span class="rounded border border-cyber-primary/50 px-2 py-1 font-mono text-xs uppercase tracking-wider text-cyber-primary">
          role: {role}
        </span>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-xs">
      {quickActions.map((a) => (
        <a
          href={a.href}
          class="rounded border border-cyber-border px-3 py-1.5 text-cyber-muted transition-colors hover:text-cyber-primary"
        >
          {a.label}
        </a>
      ))}
    </div>

    <form
      id="settings-form"
      data-i18n-saved={t.adminSettings.saved}
      data-i18n-error-prefix={t.adminSettings.errorPrefix}
      class="mt-8 space-y-5 rounded border border-cyber-border bg-cyber-panel p-6"
    >
      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">hero_title *</span>
        <input id="s-hero-title" type="text" maxlength={120}
          value={byKey.get("hero_title") ?? ""}
          class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary" />
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">hero_tagline *</span>
        <input id="s-hero-tagline" type="text" maxlength={120}
          value={byKey.get("hero_tagline") ?? ""}
          class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary" />
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">short_bio *</span>
        <textarea id="s-short-bio" rows={4} maxlength={500}
          class="w-full resize-y rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">{byKey.get("short_bio") ?? ""}</textarea>
      </label>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">availability_status *</span>
        <select id="s-availability"
          class="w-full rounded border border-cyber-border bg-cyber-panel px-4 py-2.5 font-mono text-sm text-slate-200 outline-none focus:border-cyber-primary">
          <option value="open-to-work" selected={byKey.get("availability_status") === "open-to-work"}>
            {t.adminSettings.availabilityOpen}
          </option>
          <option value="not-available" selected={byKey.get("availability_status") === "not-available"}>
            {t.adminSettings.availabilityClosed}
          </option>
        </select>
      </label>

      <div class="flex items-center gap-4">
        <button type="submit" id="s-submit"
          class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-6 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50">
          {t.adminSettings.save}
        </button>
        <p id="s-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-danger"></p>
      </div>
    </form>

    <section class="mt-10">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-mono text-lg font-bold text-white">{t.adminSettings.keyColumn}</h2>
        <span class="font-mono text-xs text-cyber-muted">{t.adminSettings.valueColumn}</span>
      </div>
      <div class="overflow-x-auto rounded border border-cyber-border bg-cyber-card">
        <table class="w-full min-w-[640px] text-left font-mono text-sm">
          <thead class="border-b border-cyber-border/60 text-[11px] uppercase tracking-wider text-cyber-muted">
            <tr>
              <th class="px-4 py-3">#</th>
              <th class="px-4 py-3">key</th>
              <th class="px-4 py-3">value</th>
            </tr>
          </thead>
          <tbody>
            {SITE_SETTING_KEYS.map((key, i) => (
              <tr class="border-b border-cyber-border/40">
                <td class="px-4 py-3 text-cyber-muted">{String(i + 1).padStart(2, "0")}</td>
                <td class="px-4 py-3 text-cyber-accent">{key}</td>
                <td class="px-4 py-3 text-slate-200">{byKey.get(key) ?? ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  const form = document.getElementById("settings-form") as HTMLFormElement;
  const savedMsg = form.dataset.i18nSaved ?? "";
  const errorPrefix = form.dataset.i18nErrorPrefix ?? "";
  const submitBtn = document.getElementById("s-submit") as HTMLButtonElement;
  const statusEl = document.getElementById("s-status") as HTMLParagraphElement;

  const fields: Array<{ key: string; input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement }> = [
    { key: "hero_title", input: document.getElementById("s-hero-title") as HTMLInputElement },
    { key: "hero_tagline", input: document.getElementById("s-hero-tagline") as HTMLInputElement },
    { key: "short_bio", input: document.getElementById("s-short-bio") as HTMLTextAreaElement },
    { key: "availability_status", input: document.getElementById("s-availability") as HTMLSelectElement },
  ];

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    statusEl.textContent = "";
    submitBtn.disabled = true;

    for (const field of fields) {
      const res = await fetch(
        `/api/admin/site-settings?key=${encodeURIComponent(field.key)}`,
        {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ value: field.input.value.trim() }),
        }
      ).catch(() => null);

      if (!res || !res.ok) {
        const data = res ? await res.json().catch(() => ({ error: "unknown" })) : { error: "network" };
        statusEl.textContent = `${errorPrefix} ${data.error ?? "gagal menyimpan"} — key ${field.key}`;
        submitBtn.disabled = false;
        return;
      }
    }

    submitBtn.disabled = false;
    statusEl.textContent = savedMsg;
  });
</script>