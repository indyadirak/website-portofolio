---
import AdminLayout from "../../layouts/AdminLayout.astro";
import TerminalButton from "../../components/admin/ui/TerminalButton.astro";
import { getDictionary, localeFromPathname } from "../../lib/i18n";
import { canManageCertificates, canManageProjects } from "../../lib/auth";

export const prerender = false;

// ===== Validasi token sesi =====
// Middleware sudah memvalidasi + auto-refresh session; guard ulang secara
// defensif agar halaman tetap aman bila diakses langsung.
const { user, profile, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/admin/login");
}

const locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

// ===== Helper query aman (B4, anti-500): error/exception -> null. =====
// Dashboard TIDAK boleh crash hanya karena satu query gagal (timeout, RLS,
// kolom belum ada, dsb) — widget menampilkan fallback 0 / N/A.
async function safeQuery<T>(
  query: PromiseLike<{ data: T | null; error: unknown }>,
): Promise<T | null> {
  try {
    const { data, error } = await query;
    if (error) {
      console.error(
        "[dashboard] query error:",
        (error as { message?: string }).message,
      );
      return null;
    }
    return data;
  } catch (err) {
    console.error("[dashboard] exception saat query:", err);
    return null;
  }
}

/** Count baris tabel (head=true) — fallback 0 saat query gagal. */
async function safeCount(
  query: PromiseLike<{ count: number | null; error: unknown }>,
): Promise<number> {
  try {
    const { count, error } = await query;
    if (error) {
      console.error(
        "[dashboard] count error:",
        (error as { message?: string }).message,
      );
      return 0;
    }
    return count ?? 0;
  } catch (err) {
    console.error("[dashboard] exception saat count:", err);
    return 0;
  }
}

// ===== Data dashboard (semua via safeQuery — tidak ada yang bisa 500) =====
const certificates = await safeQuery(
  supabase.from("certificates").select("*").order("issue_date", { ascending: false }),
);
const projects = await safeQuery(
  supabase.from("projects").select("*").order("created_at", { ascending: false }),
);
const messages = await safeQuery(
  supabase.from("contact_messages").select("*").order("created_at", { ascending: false }).limit(50),
);

// B1: total write-ups (count ringan tanpa mengambil baris).
const writeupsCount = await safeCount(
  supabase.from("writeups").select("id", { count: "exact", head: true }),
);

// ===== Status koneksi DB: dideteksi dari hasil query ringan (true/false),
// TIDAK pernah melempar — indicator checklist di bawah tetap render. =====
let dbConnected = false;
try {
  const { error } = await supabase
    .from("site_settings")
    .select("id", { count: "exact", head: true });
  dbConnected = !error;
} catch {
  dbConnected = false;
}

// ===== Unified Recent Activity Feed (data minimization) =====
// Satu sumber aman: 5 write-up terakhir yang di-publish. Feed TIDAK pernah
// menyertakan isi pesan kontak, nama/email pengirim, atau data sensitif lain.
const activity = await safeQuery(
  supabase
    .from("writeups")
    .select("id, title, is_published, created_at")
    .eq("is_published", true)
    .order("created_at", { ascending: false })
    .limit(5),
);
const recentActivity = (activity ?? [])
  .filter((w) => w.is_published)
  .slice(0, 5);

// ===== Peringatan kedaluwarsa: 90 hari ke depan, urut terdekat =====
const today = new Date();
const todayUtc = new Date(
  Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()),
);
const soonUtc = new Date(todayUtc.getTime() + 90 * 86_400_000);
const expiringSoon = (certificates ?? [])
  .filter((c) => c.expiry_date != null)
  .map((c) => ({ cert: c, expiry: new Date(`${c.expiry_date}T00:00:00Z`) }))
  .filter(({ expiry }) => expiry >= todayUtc && expiry <= soonUtc)
  .sort((a, b) => a.expiry.getTime() - b.expiry.getTime());
const expiredCount = (certificates ?? []).filter(
  (c) =>
    c.expiry_date != null && new Date(`${c.expiry_date}T00:00:00Z`) < todayUtc,
).length;

const canWrite = canManageCertificates(profile); // admin | editor (quick action)
const canWriteProjects = canManageProjects(profile); // admin | editor (quick action)
const isAdmin = profile?.role === "admin"; // publish/deploy manual

// ===== Sapaan: prefer full_name profil (camelCase di tipe Profile), fallback email =====
const displayName = profile?.fullName?.trim() || user.email;

/** Widget KPI — nilai string (fallback 0 saat query gagal/null). */
const stats: Array<{ label: string; value: string }> = [
  { label: t.dashboard.statProjects, value: String(projects?.length ?? 0) },
  { label: t.dashboard.statWriteups, value: String(writeupsCount) },
  { label: t.dashboard.statCertificates, value: String(certificates?.length ?? 0) },
  { label: t.dashboard.statInbox, value: String(messages?.length ?? 0) },
];

/** Timestamp feed: "2026-08-20 16:00" (maks. detik pertama, tanpa zona). */
const fmtTs = (iso: string | null | undefined) =>
  iso ? iso.slice(0, 16).replace("T", " ") : "????-??-?? ??:??";

// ===== System status checklist: DB dinamis; lainnya indikator tema SOC =====
const statusItems = [
  {
    ok: dbConnected,
    label: dbConnected ? t.dashboard.statusDb : t.dashboard.statusDbFail,
  },
  { ok: true, label: t.dashboard.statusMfa },
  { ok: true, label: t.dashboard.statusRateLimit },
  { ok: true, label: t.dashboard.statusRls },
  { ok: true, label: t.dashboard.statusHsts },
];
---

<AdminLayout
  title={t.dashboard.title}
  description={t.dashboard.description}
  current="dashboard"
>
  <div class="mx-auto max-w-6xl py-8 md:py-10">
    <!-- ===== HEADER TERMINAL: whoami ===== -->
    <div>
      <p class="font-mono text-sm text-cyber-accent">{t.dashboard.shellPrompt}</p>
      <h1 class="mt-2 font-mono text-2xl font-bold text-white md:text-3xl">
        {t.dashboard.welcomeBack.replace("{name}", displayName ?? "")}<span class="text-cyber-primary">;</span>
      </h1>
    </div>

    <!-- ===== KPI WIDGETS (grid 4 kolom) ===== -->
    <dl class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="rounded border border-cyber-border bg-cyber-panel p-5">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-cyber-accent">
              {stat.label}
            </dt>
            <dd class="mt-2 font-mono text-4xl font-bold text-white">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <!-- ===== QUICK ACTIONS (3 tombol besar) ===== -->
    <section class="mt-10">
      <h2 class="mb-4 font-mono text-lg font-bold text-white">
        {t.dashboard.quickActions}<span class="text-cyber-primary">;</span>
      </h2>
      <div class="flex flex-wrap gap-3">
        <TerminalButton
          href={canWriteProjects ? "/admin/projects/new" : "/admin/projects"}
          variant="primary"
          class="px-6 py-3"
        >
          {t.dashboard.quickNewProject}
        </TerminalButton>
        <TerminalButton href="/admin/writeups/new" variant="primary" class="px-6 py-3">
          {t.dashboard.quickNewWriteup}
        </TerminalButton>
        <TerminalButton
          href={canWrite ? "/admin/certificates/new" : "/admin/certificates"}
          variant="primary"
          class="px-6 py-3"
        >
          {t.dashboard.quickNewCertificate}
        </TerminalButton>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <TerminalButton href="/admin/categories" variant="ghost" class="px-3 py-1.5">
          {t.dashboard.manageCategories}
        </TerminalButton>
        <TerminalButton href="/admin/settings" variant="ghost" class="px-3 py-1.5">
          {t.dashboard.manageSettings}
        </TerminalButton>
        <TerminalButton href="/admin/experiences" variant="ghost" class="px-3 py-1.5">
          {t.dashboard.manageExperiences}
        </TerminalButton>
        <TerminalButton href="/admin/social-links" variant="ghost" class="px-3 py-1.5">
          {t.dashboard.manageSocialLinks}
        </TerminalButton>
      </div>
    </section>

    <!-- ===== PUBLISH / REBUILD PRODUCTION (admin saja) ===== -->
    {
      isAdmin && (
        <section
          id="publish-section"
          class="mt-10 rounded border border-cyber-border bg-cyber-panel p-6"
          data-i18n-triggered={t.dashboard.publishTriggered}
          data-i18n-cooldown={t.dashboard.publishCooldown}
          data-i18n-unavailable={t.dashboard.publishUnavailable}
          data-i18n-failed={t.dashboard.publishFailed}
          data-i18n-network={t.dashboard.publishNetworkError}
        >
          <h2 class="font-mono text-lg font-bold text-white">
            {t.dashboard.publishTitle}<span class="text-cyber-primary">;</span>
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-cyber-muted">
            {t.dashboard.publishDescription}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button
              id="publish-btn"
              type="button"
              class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-6 py-2.5 font-mono text-sm text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg disabled:cursor-not-allowed disabled:opacity-50"
            >
              {t.dashboard.publishButton}
            </button>
            <p
              id="publish-status"
              role="status"
              aria-live="polite"
              class="font-mono text-xs text-cyber-muted"
            ></p>
          </div>
        </section>
      )
    }

    <!-- ===== RECENT ACTIVITY FEED (ringkasan aksi — tanpa data sensitif) ===== -->
    <section class="mt-10 rounded border border-cyber-border bg-cyber-panel p-6">
      <h2 class="font-mono text-lg font-bold text-white">
        {t.dashboard.activityTitle}<span class="text-cyber-primary">;</span>
      </h2>
      <ul class="mt-4 space-y-2.5 font-mono text-sm">
        {
          recentActivity.length > 0 ? (
            recentActivity.map((w) => (
              <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="text-cyber-muted">[{fmtTs(w.created_at)}]</span>
                <span class="rounded border border-cyber-accent/50 px-1.5 py-0.5 text-[11px] uppercase tracking-wider text-cyber-accent">
                  {t.dashboard.activityModuleWriteup}
                </span>
                <span class="text-slate-300">
                  {t.dashboard.activityNewWriteup.replace("{title}", w.title)}
                </span>
              </li>
            ))
          ) : (
            <li class="text-cyber-muted">{t.dashboard.activityEmpty}</li>
          )
        }
      </ul>
    </section>

    <!-- ===== SYSTEM STATUS CHECKLIST ===== -->
    <section class="mt-10 rounded border border-cyber-border bg-cyber-panel p-6">
      <h2 class="font-mono text-lg font-bold text-white">
        {t.dashboard.systemStatus}
      </h2>
      <ul class="mt-4 space-y-2 font-mono text-sm">
        {
          statusItems.map((item) => (
            <li class={item.ok ? "text-cyber-primary" : "text-cyber-danger"}>
              {item.ok ? t.dashboard.statusOk : t.dashboard.statusFail} {item.label}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ===== PERINGATAN KEDALUWARSA SERTIFIKAT ===== -->
    {
      (expiringSoon.length > 0 || expiredCount > 0) && (
        <section class="mt-10">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="font-mono text-lg font-bold text-white">
              {t.dashboard.expiryTitle}
            </h2>
            <span class="font-mono text-xs text-cyber-muted">
              {expiringSoon.length} expiring{expiredCount > 0 && ` / ${expiredCount} expired`}
            </span>
          </div>
          <div class="space-y-4">
            {expiringSoon.map(({ cert, expiry }) => (
              <div class="flex flex-wrap items-center justify-between gap-3 rounded border border-amber-400/40 bg-cyber-card p-5">
                <div>
                  <p class="font-mono text-sm font-semibold text-amber-300">
                    {cert.title}
                  </p>
                  <p class="mt-1 font-mono text-xs text-cyber-muted">
                    {cert.issuer} — masa berlaku {cert.expiry_date}
                  </p>
                </div>
                <span class="rounded border border-amber-400/40 px-2 py-1 font-mono text-xs text-amber-300">
                  {Math.ceil((expiry.getTime() - todayUtc.getTime()) / 86_400_000)} hari lagi
                </span>
              </div>
            ))}
            {
              expiredCount > 0 && (
                <p class="rounded border border-cyber-danger/50 bg-cyber-card p-4 font-mono text-xs text-cyber-danger">
                  $ warning: {expiredCount} sertifikat sudah lewat masa berlaku — verifikasi ulang atau perbarui expiry_date.
                </p>
              )
            }
          </div>
        </section>
      )
    }

    <!-- ===== PESAN KONTAK MASUK (baca: semua role) ===== -->
    <section class="mt-10">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-mono text-lg font-bold text-white">{t.dashboard.contactTitle}</h2>
        <span class="font-mono text-xs text-cyber-muted">
          {t.dashboard.total}: {messages?.length ?? 0}
        </span>
      </div>

      {
        (messages ?? []).length > 0 ? (
          <div class="space-y-4">
            {messages?.map((msg) => (
              <div class="rounded border border-cyber-border bg-cyber-card p-5">
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
                  <p class="text-cyber-primary">{msg.name} <span class="text-cyber-muted">&lt;{msg.email}&gt;</span></p>
                  <p class="text-cyber-muted">
                    {new Date(msg.created_at).toLocaleString("id-ID")}
                  </p>
                </div>
                <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-slate-300">
                  {msg.message}
                </p>
              </div>
            ))}
          </div>
        ) : (
          <p class="rounded border border-cyber-border bg-cyber-card p-6 font-mono text-xs text-cyber-muted">
            $ echo "belum ada pesan masuk — form kontak di halaman /contact & /en/contact menyimpan ke tabel contact_messages."
          </p>
        )
      }
    </section>
  </div>
</AdminLayout>

<script>
  const publishSection = document.getElementById("publish-section");
  const publishBtn = document.getElementById("publish-btn") as HTMLButtonElement | null;
  const publishStatus = document.getElementById("publish-status") as HTMLParagraphElement | null;

  publishBtn?.addEventListener("click", async () => {
    if (!publishBtn || !publishStatus) return;
    publishBtn.disabled = true;
    publishStatus.textContent = "...";
    try {
      const res = await fetch("/api/admin/deploy", { method: "POST" });
      const data = (await res.json().catch(() => null)) as {
        ok?: boolean;
        deploy?: string;
        error?: string;
      } | null;
      if (data?.deploy === "triggered") {
        publishStatus.textContent = publishSection?.dataset.i18nTriggered ?? "ok";
      } else if (data?.deploy === "cooldown") {
        publishStatus.textContent = publishSection?.dataset.i18nCooldown ?? "cooldown";
      } else if (data?.error === "deploy_token_missing") {
        publishStatus.textContent = publishSection?.dataset.i18nUnavailable ?? "unavailable";
      } else {
        publishStatus.textContent = publishSection?.dataset.i18nFailed ?? "failed";
      }
    } catch {
      publishStatus.textContent = publishSection?.dataset.i18nNetwork ?? "network error";
    }
    publishBtn.disabled = false;
  });
</script>
