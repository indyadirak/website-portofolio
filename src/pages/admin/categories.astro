---
import AdminLayout from "../../layouts/AdminLayout.astro";
import TerminalButton from "../../components/admin/ui/TerminalButton.astro";
import TerminalInput from "../../components/admin/ui/TerminalInput.astro";
import CategoryList from "../../components/admin/CategoryList.astro";
import { canDeleteProjects, canManageProjects } from "../../lib/auth";
import type { ProjectCategoryRow } from "../../lib/types";

export const prerender = false;

const { user, profile, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/admin/login");
}

if (!canManageProjects(profile)) {
  return Astro.redirect("/403");
}

const { data: rawCategories } = await supabase
  .from("project_categories")
  .select("*")
  .order("sort_order", { ascending: true })
  .order("name", { ascending: true });

const categories = (rawCategories ?? []) as ProjectCategoryRow[];
const canDelete = canDeleteProjects(profile);
---

<AdminLayout
  title="Categories — Admin"
  description="Kelola kategori proyek dinamis (B2)."
  current="categories"
>
  <div class="mx-auto max-w-4xl py-8 md:py-10">
    <div>
      <p class="font-mono text-sm text-cyber-accent">$ categories --manage</p>
      <h1 class="mt-2 font-mono text-3xl font-bold text-white">
        Project Categories<span class="text-cyber-primary">;</span>
      </h1>
    </div>

    <form id="category-form" class="mt-8 space-y-5 rounded border border-cyber-border bg-cyber-panel p-6">
      <p id="category-form-mode" class="font-mono text-xs uppercase tracking-wider text-cyber-accent">
        [ new_category ]
      </p>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="block">
          <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Name *</span>
          <TerminalInput id="c-name" type="text" required minlength={2} maxlength={80} placeholder="Cloud Security" />
        </label>
        <label class="block">
          <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Slug *</span>
          <TerminalInput id="c-slug" type="text" required pattern="[a-z0-9-]+" placeholder="auto: cloud-security" />
        </label>
      </div>

      <label class="block">
        <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Description</span>
        <TerminalInput id="c-description" type="text" maxlength={200} placeholder="Deskripsi singkat kategori (opsional)" />
      </label>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="block">
          <span class="mb-2 block font-mono text-xs uppercase tracking-wider text-cyber-accent">Sort Order</span>
          <TerminalInput id="c-sort" type="number" min={0} max={9999} value="0" />
        </label>
        <div class="flex min-h-11 items-end pb-1">
          <label class="flex cursor-pointer items-center gap-3">
            <input id="c-active" type="checkbox" checked
              class="h-5 w-5 rounded border-cyber-border bg-cyber-panel accent-cyber-primary" />
            <span class="font-mono text-xs uppercase tracking-wider text-cyber-accent">Active — tampil di UI publik</span>
          </label>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <TerminalButton type="submit" id="c-submit" disabled>
          [ save_category ]
        </TerminalButton>
        <TerminalButton type="button" id="c-cancel" variant="ghost" hidden>
          [ cancel_edit ]
        </TerminalButton>
        <p id="c-status" role="status" aria-live="polite" class="font-mono text-xs text-cyber-danger"></p>
      </div>
    </form>

    <section class="mt-10">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="font-mono text-lg font-bold text-white">All Categories</h2>
        <span class="font-mono text-xs text-cyber-muted">total: {categories.length}</span>
      </div>
      <CategoryList categories={categories} canDelete={canDelete} />
    </section>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("category-form") as HTMLFormElement;
  const modeEl = document.getElementById("category-form-mode") as HTMLParagraphElement;
  const submitBtn = document.getElementById("c-submit") as HTMLButtonElement;
  const cancelBtn = document.getElementById("c-cancel") as HTMLButtonElement;
  const statusEl = document.getElementById("c-status") as HTMLParagraphElement;

  const nameInput = document.getElementById("c-name") as HTMLInputElement;
  const slugInput = document.getElementById("c-slug") as HTMLInputElement;
  const descInput = document.getElementById("c-description") as HTMLInputElement;
  const sortInput = document.getElementById("c-sort") as HTMLInputElement;
  const activeInput = document.getElementById("c-active") as HTMLInputElement;

  let editingId: string | null = null;

  function slugify(value: string): string {
    return value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  nameInput.addEventListener("input", () => {
    if (!editingId && document.activeElement !== slugInput) {
      slugInput.value = slugify(nameInput.value);
    }
  });

  function setMode(editing: boolean): void {
    modeEl.textContent = editing ? "[ edit_category ]" : "[ new_category ]";
    submitBtn.textContent = editing ? "[ update_category ]" : "[ save_category ]";
    cancelBtn.hidden = !editing;
  }

  window.addEventListener("category:edit", ((event: Event) => {
    const detail = (event as CustomEvent<{ id: string; name: string; slug: string; sortOrder: number; isActive: boolean }>).detail;
    editingId = detail.id;
    nameInput.value = detail.name;
    slugInput.value = detail.slug;
    sortInput.value = String(detail.sortOrder);
    activeInput.checked = detail.isActive;
    setMode(true);
    form.scrollIntoView({ behavior: "smooth", block: "start" });
    nameInput.focus();
  }) as EventListener);

  cancelBtn.addEventListener("click", () => {
    editingId = null;
    form.reset();
    sortInput.value = "0";
    activeInput.checked = true;
    setMode(false);
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    statusEl.textContent = "";
    submitBtn.disabled = true;

    const payload = {
      name: nameInput.value.trim(),
      slug: slugInput.value.trim() || undefined,
      description: descInput.value.trim() || null,
      sortOrder: Number(sortInput.value) || 0,
      isActive: activeInput.checked,
    };

    const res = await fetch(
      editingId ? `/api/admin/categories?id=${encodeURIComponent(editingId)}` : "/api/admin/categories",
      {
        method: editingId ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      }
    ).catch(() => null);

    if (!res) {
      statusEl.textContent = "$ error: jaringan gagal";
      submitBtn.disabled = false;
      return;
    }

    const data = await res.json().catch(() => ({ ok: false, error: "invalid_response" }));

    submitBtn.disabled = false;

    if (!res.ok || !data.ok) {
      statusEl.textContent = `$ error: ${data.error ?? "gagal menyimpan"}`;
      return;
    }

    statusEl.textContent = "$ saved — reloading...";
    window.location.reload();
  });
</script>
