---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getProjects } from "../../../lib/data/projects";
import { getDictionary, locales, localeFromPathname, type Locale } from "../../../lib/i18n";

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getProjects();
  const paths = [];
  for (const locale of locales) {
    for (const project of projects) {
      paths.push({
        params: { lang: locale, slug: project.slug },
        props: { project },
      });
    }
  }
  return paths;
}

interface Props {
  project: import("../../../lib/types").Project;
}

const { project } = Astro.props;

const locale: Locale = localeFromPathname(Astro.url.pathname) ?? "id";
const t = getDictionary(locale);

const allProjects = await getProjects();
const related = allProjects
  .filter((p) => p.category === project.category && p.slug !== project.slug)
  .slice(0, 3);
---

<BaseLayout
  title={project.title}
  description={project.summary}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-sm text-cyber-accent">$ cat ./projects/{project.slug}.md</p>

    <h1 class="mt-3 font-mono text-4xl font-bold text-white">{project.title}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-3 font-mono text-xs">
      <span class="rounded bg-cyber-panel px-2 py-1 uppercase tracking-wider text-cyber-accent">
        {project.category}
      </span>
      <span class="uppercase tracking-wider text-cyber-muted">
        {t.projects.statusLabel}: {project.status}
      </span>
      <span class="text-cyber-muted">
        {t.projects.addedLabel}: {new Date(project.createdAt).toLocaleDateString(locale === "en" ? "en-US" : "id-ID")}
      </span>
    </div>

    <div class="my-8 h-px w-full bg-cyber-border" />

    <p class="text-lg leading-relaxed text-slate-200">{project.description}</p>

    <div class="mt-8 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <span class="rounded border border-cyber-border px-2 py-1 font-mono text-xs text-cyber-primary">
          #{tag}
        </span>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap gap-4 font-mono text-sm">
      {project.repoUrl && (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-cyber-primary/60 bg-cyber-primary/10 px-5 py-2.5 text-cyber-primary transition-colors hover:bg-cyber-primary hover:text-cyber-bg"
        >
          {t.projects.sourceCode}
        </a>
      )}
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-cyber-border px-5 py-2.5 text-slate-300 transition-colors hover:border-cyber-accent hover:text-cyber-accent"
        >
          {t.projects.liveDemo}
        </a>
      )}
    </div>

    {
      related.length > 0 && (
        <aside class="mt-16">
          <h2 class="mb-4 font-mono text-lg font-bold text-cyber-primary">{t.projects.relatedTitle}</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {related.map((item) => (
              <a
                href={getRelativeLocaleUrl(locale, `projects/${item.slug}`)}
                class="rounded border border-cyber-border bg-cyber-card p-4 transition-colors hover:border-cyber-primary/60"
              >
                <p class="font-mono text-sm font-semibold text-slate-200">{item.title}</p>
                <p class="mt-1 font-mono text-[11px] text-cyber-muted">{item.category}</p>
              </a>
            ))}
          </div>
        </aside>
      )
    }

    <p class="mt-16 font-mono text-xs text-cyber-muted">
      $ echo "end of file" <span class="text-cyber-primary">■</span>
    </p>
  </article>
</BaseLayout>
