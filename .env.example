# Supabase (public anon key — aman untuk frontend, JANGAN pernah menaruh service_role key di sini)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (anti-bot form kontak)
# Ambil di dashboard Cloudflare -> Turnstile -> Add Site (mode: Managed)
# Kosongkan keduanya untuk menonaktifkan CAPTCHA saat development.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# NOTE: di PRODUKSI secret ini dipasang sebagai RUNTIME secret Worker
# (`npx wrangler secret put TURNSTILE_SECRET_KEY` / GitHub Actions), BUKAN
# lewat .env — supaya tidak pernah ter-bake ke bundle build. Nilai di sini
# hanya untuk `npm run dev` lokal.
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
